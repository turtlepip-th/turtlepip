---
interface Props {
  pose?: 'tablet' | 'happy' | 'thinking' | 'serious';
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
  class?: string;
}

const {
  pose = 'tablet',
  size = 'md',
  alt,
  class: className = '',
} = Astro.props;

const altText = alt ?? {
  tablet:   'ทีมซุปเต่ากำลังวิเคราะห์ข้อมูลโบรก',
  happy:    'ทีมซุปเต่ายินดีต้อนรับ',
  thinking: 'ทีมซุปเต่ากำลังคิดวิเคราะห์',
  serious:  'ทีมซุปเต่าแจ้งเตือน',
}[pose];

const sizeClass = { sm: 'mascot-sm', md: 'mascot-md', lg: 'mascot-lg' }[size];
---

<img
  src={`/mascot/mascot-${pose}.png`}
  alt={altText}
  class={`mascot ${sizeClass} ${className}`}
  loading="lazy"
  decoding="async"
/>
