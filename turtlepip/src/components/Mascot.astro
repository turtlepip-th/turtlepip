---
interface Props {
  pose?: 'tablet' | 'happy' | 'thinking' | 'serious';
  alt?: string;
}

const { pose = 'tablet', alt } = Astro.props;

const altText = alt ?? {
  tablet:   'ทีมซุปเต่ากำลังวิเคราะห์ข้อมูลโบรก',
  happy:    'ทีมซุปเต่ายินดีต้อนรับ',
  thinking: 'ทีมซุปเต่ากำลังคิดวิเคราะห์',
  serious:  'ทีมซุปเต่าแจ้งเตือน',
}[pose];

// tablet is the high-res full body — show larger
// the 3 head poses are lower res — keep small
const width = pose === 'tablet' ? '140px' : '80px';
---

<div style="display:flex;justify-content:flex-end;padding:8px 0 0;">
  <img
    src={`/mascot/mascot-${pose}.png`}
    alt={altText}
    loading="lazy"
    decoding="async"
    style={`width:${width};height:auto;display:block;`}
  />
</div>
