---
interface Props {
  pose?: 'tablet' | 'happy' | 'thinking' | 'serious';
  alt?: string;
}

const { pose = 'tablet', alt } = Astro.props;

const altText = alt ?? {
  tablet:   'ทีมซุปเต่ากำลังวิเคราะห์ข้อมูลโบรก',
  happy:    'ทีมซุปเต่ายินดีต้อนรับ',
  thinking: 'ทีมซุปเต่ากำลังคิดวิเคราะห์',
  serious:  'ทีมซุปเต่าแจ้งเตือน',
}[pose];

const dims = pose === 'tablet'
  ? { w: 200, h: 267, css: '140px' }
  : { w: 260, h: 236, css: '80px' };
---

<div style="display:flex;justify-content:flex-end;padding:8px 0 0;">
  <img
    src={`/mascot/mascot-${pose}.webp`}
    alt={altText}
    width={dims.w}
    height={dims.h}
    loading="lazy"
    decoding="async"
    style={`width:${dims.css};height:auto;display:block;`}
  />
</div>
