---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import xs from '../data/brokers/xs.json';
import pepperstone from '../data/brokers/pepperstone.json';
import exness from '../data/brokers/exness.json';
import hfm from '../data/brokers/hfm.json';
import xm from '../data/brokers/xm.json';
import xsRebate from '../data/rebates/xs.json';

const brokers = [xs, pepperstone, exness, hfm, xm].sort((a, b) => a.rank - b.rank);

const recommendedCount = brokers.filter((b) => b.status === 'recommended').length;
const neutralCount = brokers.filter((b) => b.status === 'neutral').length;

const xauRebate = xsRebate.rates.find((r) => r.symbol === 'XAUUSD')!;
const rebateLo = xauRebate.cashbackUsd[0];
const rebateHi = xauRebate.cashbackUsd[1];
const fmtUsd = (n: number) => (Number.isInteger(n) ? n.toString() : n.toFixed(2));
const rebateRange = `$${fmtUsd(rebateLo)}–${fmtUsd(rebateHi)}`;
const thbRate = xsRebate.thbRate;
---

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TurtlePip — รีวิวโบรกเกอร์ Forex จากข้อมูลจริง</title>
<link rel="canonical" href="https://turtlepip.com/">
<meta name="description" content="รีวิวโบรกเกอร์ Forex ภาษาไทย โดยทีมซุปเต่า เปรียบเทียบข้อมูลจริงเรื่องสเปรด ค่าธรรมเนียม ใบอนุญาต และเงื่อนไขถอนเงิน">
<link rel="stylesheet" href="/shared.css">
<style>
/* ============================================
   MOBILE-FIRST — base styles are mobile.
   Desktop expands at 821px.
   ============================================ */

* { box-sizing: border-box; }

/* ---------- STATS STRIP (CoinGecko ticker) ---------- */
.ticker {
  background: var(--surf);
  border-bottom: 1px solid var(--bdr);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.ticker::-webkit-scrollbar { display: none; }
.ticker-in {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 8px 16px;
  white-space: nowrap;
  max-width: 1120px;
  margin: 0 auto;
}
.tk { font-size: 12px; color: var(--t3); flex-shrink: 0; }
.tk b { color: var(--t1); font-family: monospace; font-weight: 700; }
.tk b.g { color: var(--safe); }
.tk b.bl { color: #1D4ED8; }

/* ---------- PAGE WRAP ---------- */
.pg {
  max-width: 1120px;
  margin: 0 auto;
  padding: 16px;
}

/* ---------- PAGE HEAD ---------- */
.page-head { margin-bottom: 14px; }
.page-head h1 {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -.3px;
  color: var(--t1);
  margin-bottom: 4px;
}
.page-head p { font-size: 12px; color: var(--t2); line-height: 1.6; }

/* ---------- FILTER TABS ---------- */
.tabs {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  margin-bottom: 12px;
  padding-bottom: 2px;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  flex-shrink: 0;
  padding: 7px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--t2);
  background: var(--surf);
  border: 1px solid var(--bdr);
  border-radius: 20px;
  cursor: pointer;
  font-family: var(--f);
  transition: all .15s;
}
.tab.on {
  background: var(--gd);
  color: white;
  border-color: var(--gd);
}

/* ---------- BROKER TABLE (CoinGecko core) ---------- */
.tbl-card {
  background: var(--surf);
  border: 1px solid var(--bdr);
  border-radius: var(--rl);
  overflow: hidden;
  margin-bottom: 20px;
}
.tbl-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
table.rank {
  width: 100%;
  min-width: 720px;
  border-collapse: separate;
  border-spacing: 0;
}
.rank th {
  position: sticky;
  top: 0;
  background: var(--bg);
  font-size: 10px;
  font-weight: 700;
  color: var(--t3);
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 10px 12px;
  border-bottom: 1px solid var(--bdr);
  text-align: right;
  white-space: nowrap;
  z-index: 2;
}
.rank th.broker-col { text-align: left; }
.rank td {
  padding: 12px;
  border-bottom: 1px solid var(--bdr);
  text-align: right;
  white-space: nowrap;
  font-size: 13px;
  vertical-align: middle;
}
.rank tr:last-child td { border-bottom: none; }
.rank tbody tr { cursor: pointer; transition: background .1s; }
.rank tbody tr:hover td { background: var(--bg); }

/* Sticky broker column — the CoinGecko mobile pattern */
.rank th.broker-col,
.rank td.broker-cell {
  position: sticky;
  left: 0;
  background: var(--surf);
  text-align: left;
  z-index: 1;
  min-width: 180px;
  max-width: 220px;
  box-shadow: 4px 0 8px -4px rgba(0,0,0,0.06);
}
.rank th.broker-col { background: var(--bg); z-index: 3; }
.rank tbody tr:hover td.broker-cell { background: var(--bg); }

.bk {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.bk-rank {
  font-size: 11px;
  font-weight: 700;
  color: var(--t3);
  font-family: monospace;
  width: 14px;
  flex-shrink: 0;
}
.bk-logo {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--bdr);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bk-logo img { width: 100%; height: 100%; object-fit: contain; }
.bk-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--t1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bk-reg {
  font-size: 10px;
  color: var(--t3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lic-badge {
  background: #EEF2FF;
  color: #3730A3;
  font-size: 8px;
  font-weight: 700;
  padding: 1px 4px;
  border-radius: 8px;
  vertical-align: middle;
}

/* Data cells */
.score-val {
  font-family: monospace;
  font-weight: 800;
  font-size: 14px;
}
.score-val.g { color: var(--safe); }
.score-val.bl { color: #1D4ED8; }
.rebate-val {
  font-family: monospace;
  font-weight: 800;
  font-size: 13px;
  color: var(--safe);
  background: var(--gp);
  padding: 3px 8px;
  border-radius: 6px;
  display: inline-block;
}
.rebate-soon { font-size: 11px; color: var(--t3); }
.spread-val { font-family: monospace; font-weight: 600; font-size: 12px; }
.spread-val.lo { color: var(--safe); }
.spread-val.md { color: var(--warn); }
.spread-val.hi { color: var(--avoid); }
.dep-val { font-family: monospace; font-size: 12px; color: var(--t2); }

.btn-go {
  display: inline-block;
  background: var(--gp);
  color: var(--gd);
  border: 1px solid #C3E6A0;
  border-radius: 7px;
  padding: 6px 12px;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
  font-family: var(--f);
  transition: all .15s;
}
.btn-go:hover { background: var(--gd); color: white; border-color: var(--gd); }
.btn-go.disabled { opacity: .45; pointer-events: none; }

.tbl-note {
  padding: 9px 14px;
  font-size: 10px;
  color: var(--t3);
  background: var(--bg);
  border-top: 1px solid var(--bdr);
  line-height: 1.6;
}

/* ---------- REBATE CALCULATOR — signature ---------- */
.calc {
  background: var(--gd);
  border-radius: var(--rl);
  padding: 22px 18px;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
}
.calc::after {
  content: '';
  position: absolute;
  width: 220px; height: 220px;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  top: -80px; right: -60px;
  pointer-events: none;
}
.calc-tag {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  color: var(--cream);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 12px;
  margin-bottom: 10px;
}
.calc h2 {
  font-size: 18px;
  font-weight: 800;
  color: white;
  margin-bottom: 4px;
  letter-spacing: -.2px;
}
.calc-sub { font-size: 12px; color: rgba(255,255,255,0.65); margin-bottom: 18px; }
.calc-row { margin-bottom: 16px; position: relative; }
.calc-label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 12px;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8px;
}
.calc-label b { color: white; font-family: monospace; font-size: 15px; }
input[type="range"].calc-slider {
  width: 100%;
  height: 6px;
  -webkit-appearance: none;
  appearance: none;
  background: rgba(255,255,255,0.2);
  border-radius: 3px;
  outline: none;
}
input[type="range"].calc-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: white;
  cursor: pointer;
  border: 4px solid var(--gm);
}
input[type="range"].calc-slider::-moz-range-thumb {
  width: 22px; height: 22px;
  border-radius: 50%;
  background: white;
  cursor: pointer;
  border: 4px solid var(--gm);
}
.calc-result {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: var(--r);
  padding: 16px;
  text-align: center;
  position: relative;
}
.calc-result-label { font-size: 11px; color: rgba(255,255,255,0.6); margin-bottom: 4px; }
.calc-result-val {
  font-size: 26px;
  font-weight: 800;
  font-family: monospace;
  color: var(--cream);
  letter-spacing: -.5px;
}
.calc-result-sub { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 4px; }
.calc-cta {
  display: block;
  background: white;
  color: var(--gd);
  text-align: center;
  border-radius: 9px;
  padding: 13px;
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
  margin-top: 14px;
  font-family: var(--f);
  position: relative;
}

/* ---------- ARTICLES ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 10px;
}
.sec-title { font-size: 14px; font-weight: 800; color: var(--t1); }
.sec-link { font-size: 12px; color: var(--gd); font-weight: 600; text-decoration: none; }
.art-card {
  background: var(--surf);
  border: 1px solid var(--bdr);
  border-radius: var(--rl);
  overflow: hidden;
  margin-bottom: 20px;
}
.art {
  display: block;
  padding: 13px 16px;
  border-bottom: 1px solid var(--bdr);
  text-decoration: none;
  transition: background .1s;
}
.art:last-child { border-bottom: none; }
.art:hover { background: var(--bg); }
.art-tag {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin-bottom: 3px;
}
.art-tag.d { color: var(--avoid); }
.art-tag.g { color: var(--gd); }
.art-tag.t { color: var(--safe); }
.art-title { font-size: 13px; font-weight: 600; line-height: 1.45; color: var(--t1); margin-bottom: 2px; }
.art-meta { font-size: 11px; color: var(--t3); }

/* ---------- XS BANNER ---------- */
.banner-wrap { padding: 4px 0 0; margin-bottom: 4px; }
.banner-wrap a { display: block; }
.banner-wrap img {
  width: 100%;
  height: auto;
  border-radius: var(--r);
  display: block;
  border: 1px solid var(--bdr);
}
.banner-disc { font-size: 9px; color: var(--t3); text-align: center; margin-top: 5px; }

/* ============================================
   DESKTOP — 821px and up
   ============================================ */
@media (min-width: 821px) {
  .pg { padding: 24px 28px; }
  .page-head h1 { font-size: 24px; }
  .page-head p { font-size: 13px; }
  .ticker-in { padding: 9px 28px; }
  table.rank { min-width: 100%; }
  .rank th, .rank td { padding: 13px 16px; }
  .rank td.broker-cell { min-width: 240px; max-width: none; box-shadow: none; }
  .calc { padding: 28px 32px; }
  .calc-grid { display: grid; grid-template-columns: 1fr 280px; gap: 28px; align-items: center; }
  .calc-result { margin-top: 0; }
  .calc h2 { font-size: 22px; }
}
</style>
</head>
<body>

<Nav active="brokers" />

<!-- TICKER STRIP -->
<div class="ticker">
  <div class="ticker-in">
    <span class="tk">โบรกที่รีวิว: <b>{brokers.length}</b></span>
    <span class="tk">แนะนำ: <b class="g">{recommendedCount}</b></span>
    <span class="tk">กลาง: <b class="bl">{neutralCount}</b></span>
    <span class="tk">ข้อมูล: <b>พ.ค. 2026</b></span>
  </div>
</div>

<div class="pg">

  <!-- PAGE HEAD -->
  <div class="page-head">
    <h1>อันดับโบรกเกอร์ Forex 2026</h1>
    <p>จัดอันดับจากข้อมูลจริง — สมัครผ่าน TurtlePip รับ Rebate คืนทุก lot</p>
  </div>

  <!-- FILTER TABS -->
  <div class="tabs">
    <button class="tab on" onclick="filterTab('all',this)">ทั้งหมด</button>
    <button class="tab" onclick="filterTab('rebate',this)">มี Rebate</button>
    <button class="tab" onclick="filterTab('scalper',this)">Scalper</button>
    <button class="tab" onclick="filterTab('daytrader',this)">Day Trader</button>
    <button class="tab" onclick="filterTab('swing',this)">Swing</button>
    <button class="tab" onclick="filterTab('beginner',this)">Low Deposit</button>
  </div>

  <!-- RANKING TABLE -->
  <div class="tbl-card">
    <div class="tbl-scroll">
      <table class="rank">
        <thead>
          <tr>
            <th class="broker-col">โบรกเกอร์</th>
            <th>คะแนน</th>
            <th>Rebate XAU/lot</th>
            <th>สเปรด XAU</th>
            <th>ฝากขั้นต่ำ</th>
            <th>สถานะ</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rankBody">
          {brokers.map((b) => (
            <tr data-tags={b.tags.join(' ')} onclick={b.reviewUrl ? `location.href='${b.reviewUrl}'` : 'void(0)'}>
              <td class="broker-cell">
                <div class="bk">
                  <span class="bk-rank">{b.rank}</span>
                  <div class="bk-logo" style={`background:${b.logoBg};`}>
                    <img src={b.logo} alt={b.name} style={b.logoStyle} />
                  </div>
                  <div style="min-width:0;">
                    <div class="bk-name">{b.name}</div>
                    <div class="bk-reg">
                      {b.regulators.join(' · ')}
                      {b.extraLicenses > 0 && <span class="lic-badge">+{b.extraLicenses}</span>}
                    </div>
                  </div>
                </div>
              </td>
              <td><span class={`score-val ${b.scoreColor}`}>{b.score.toFixed(1)}</span></td>
              <td>
                {b.hasRebate ? (
                  <a href="/rebate" onclick="event.stopPropagation()" style="text-decoration:none;"><span class="rebate-val">{rebateRange}</span></a>
                ) : (
                  <span class="rebate-soon">เร็วๆ นี้</span>
                )}
              </td>
              <td><span class={`spread-val ${b.spreadLevel}`}>{b.spreads.xauusd}</span></td>
              <td><span class="dep-val">{b.minDeposit.display}</span></td>
              <td><span class={`badge ${b.status === 'recommended' ? 'bsafe' : 'bneutral'}`}>{b.statusLabel}</span></td>
              <td>
                {b.reviewUrl ? (
                  <a href={b.reviewUrl} class="btn-go" onclick="event.stopPropagation()">รีวิว</a>
                ) : (
                  <span class="btn-go disabled">เร็วๆ นี้</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="tbl-note">
      Standard Account · สเปรด XAUUSD ณ พ.ค. 2026 (1 pt = $0.01) · *Exness กำลัง monitor อัปเดตเร็วๆ นี้ · เลื่อนตารางซ้าย-ขวาได้บนมือถือ
    </div>
  </div>

  <!-- REBATE CALCULATOR — signature -->
  <div class="calc">
    <div class="calc-tag">Rebate Calculator</div>
    <div class="calc-grid">
      <div>
        <h2>เทรดเท่าไหร่ ได้คืนเท่าไหร่?</h2>
        <p class="calc-sub">คำนวณ cashback ที่จะได้รับจากการเทรด XAUUSD กับ XS.com ผ่าน TurtlePip</p>
        <div class="calc-row">
          <div class="calc-label">
            <span>จำนวน lots ต่อเดือน (XAUUSD)</span>
            <b id="lotsVal">20 lots</b>
          </div>
          <input type="range" class="calc-slider" id="lotsSlider" min="1" max="200" value="20" oninput="calcRebate()">
        </div>
      </div>
      <div>
        <div class="calc-result">
          <div class="calc-result-label">Rebate ที่ได้รับต่อเดือน</div>
          <div class="calc-result-val" id="rebateOut">฿2,100–3,500</div>
          <div class="calc-result-sub" id="rebateUsd">~$60–100 / เดือน</div>
        </div>
        <a href="/rebate" class="calc-cta">ดูรายละเอียด & สมัครรับ Rebate →</a>
      </div>
    </div>
  </div>

  <!-- ARTICLES -->
  <div class="sec-head">
    <span class="sec-title">บทความล่าสุด</span>
    <a href="/blog" class="sec-link">ดูทั้งหมด →</a>
  </div>
  <div class="art-card">
    <a href="/blog" class="art">
      <div class="art-tag d">แจ้งเตือน</div>
      <div class="art-title">โบรกเกอร์ไหนเปลี่ยนทีมบริหารแล้ว — และธุรกิจเปลี่ยนไปอย่างไรในปี 2026</div>
      <div class="art-meta">8 นาทีอ่าน</div>
    </a>
    <a href="/articles/abook-bbook" class="art">
      <div class="art-tag g">คู่มือ</div>
      <div class="art-title">A-Book vs B-Book คืออะไร — โบรกเกอร์ทำเงินจากคุณยังไง?</div>
      <div class="art-meta">6 นาทีอ่าน</div>
    </a>
    <a href="/blog" class="art">
      <div class="art-tag t">ทดสอบจริง</div>
      <div class="art-title">ทดสอบถอนเงิน XS.com vs Pepperstone — ใครเร็วกว่า? ผลจริงพร้อมสกรีนช็อต</div>
      <div class="art-meta">5 นาทีอ่าน</div>
    </a>
  </div>

  <!-- XS BANNER -->
  <div class="banner-wrap">
    <a href="https://my.xs.com/marketing/links/go/413" target="_blank" rel="nofollow noopener sponsored">
      <img src="/logos/xs-banner.jpg" alt="XS.com — เปิดบัญชีเทรด">
    </a>
    <div class="banner-disc">Sponsored · การเทรด CFD มีความเสี่ยงสูง</div>
  </div>

</div>

<Footer />

<script define:vars={{ rebateLo, rebateHi, thbRate }}>
function filterTab(tag, btn) {
  document.querySelectorAll('.tab').forEach(function(t){ t.classList.remove('on'); });
  btn.classList.add('on');
  document.querySelectorAll('#rankBody tr').forEach(function(r) {
    if (tag === 'all') { r.style.display = ''; return; }
    var tags = r.dataset.tags || '';
    r.style.display = tags.indexOf(tag) > -1 ? '' : 'none';
  });
}
// @ts-expect-error - exposed for inline onclick handler
window.filterTab = filterTab;

/* Rebate calculator — XAUUSD Standard: rebateLo–rebateHi USD/lot, THB ~thbRate */
function calcRebate() {
  var lots = parseInt(document.getElementById('lotsSlider').value, 10);
  document.getElementById('lotsVal').textContent = lots + ' lots';
  var loUsd = lots * rebateLo;
  var hiUsd = lots * rebateHi;
  var loThb = Math.round(loUsd * thbRate);
  var hiThb = Math.round(hiUsd * thbRate);
  document.getElementById('rebateOut').textContent =
    '฿' + loThb.toLocaleString() + '–' + hiThb.toLocaleString();
  var fmt = function(n) { return Number.isInteger(n) ? n.toString() : n.toFixed(2); };
  document.getElementById('rebateUsd').textContent =
    '~$' + fmt(loUsd) + '–' + fmt(hiUsd) + ' / เดือน';
}
// @ts-expect-error - exposed for inline onclick handler
window.calcRebate = calcRebate;
calcRebate();
</script>
</body>
</html>
