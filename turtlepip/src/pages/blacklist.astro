---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';
import blacklistData from '../data/blacklist.json';

const { entries } = blacklistData;
---

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TurtlePip — รีวิวโบรกเกอร์ Forex จากข้อมูลจริง</title>
<meta name="description" content="รีวิวโบรกเกอร์ Forex ภาษาไทย โดยทีมซุปเต่า เปรียบเทียบข้อมูลจริงเรื่องสเปรด ค่าธรรมเนียม ใบอนุญาต และเงื่อนไขถอนเงิน">
<link rel="canonical" href="https://turtlepip.com/blacklist">
<link rel="alternate" hreflang="th" href="https://turtlepip.com/blacklist">
<link rel="alternate" hreflang="en" href="https://turtlepip.com/blacklist">
<link rel="alternate" hreflang="x-default" href="https://turtlepip.com/blacklist">
<link rel="stylesheet" href="/shared.css">
<style>
  .page-hero { margin-bottom: 24px; }
  .page-hero h1 { font-size: 24px; font-weight: 800; letter-spacing: -.4px; margin-bottom: 6px; }
  .page-hero p  { font-size: 13px; color: var(--t2); max-width: 600px; line-height: 1.7; }

  .criteria-box {
    background: var(--gp); border: 1px solid #C3E6A0;
    border-radius: var(--rl); padding: 16px 20px; margin-bottom: 24px;
  }
  .criteria-title { font-size: 13px; font-weight: 700; color: var(--gd); margin-bottom: 10px; }
  .criteria-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .criteria-item { display: flex; gap: 8px; font-size: 12px; color: var(--t2); align-items: flex-start; }
  .criteria-tick { color: var(--safe); font-weight: 700; flex-shrink: 0; }

  /* STATUS LEGEND */
  .legend { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--t2); }

  /* BCARD */
  .bcard {
    background: var(--surf); border: 1px solid var(--bdr);
    border-radius: var(--rl); overflow: hidden; margin-bottom: 14px;
  }
  .bcard.avoid  { border-left: 4px solid var(--avoid); }
  .bcard.inactive { border-left: 4px solid var(--t3); }

  .bcard-head {
    padding: 14px 20px; display: flex; align-items: flex-start;
    justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--bdr);
  }
  .bcard-name { font-size: 16px; font-weight: 800; margin-bottom: 3px; color: var(--t1); }
  .bcard-reg  { font-size: 11px; color: var(--t3); }

  .blevel {
    font-size: 10px; font-weight: 800; padding: 3px 10px;
    border-radius: 20px; white-space: nowrap; flex-shrink: 0; margin-top: 2px;
  }
  .blevel.avoid    { background: var(--avoidbg); color: var(--avoid); }
  .blevel.inactive { background: #F1F5F9; color: #64748B; }

  .bcard-body { padding: 14px 20px; }
  .reasons { list-style: none; padding: 0; margin-bottom: 12px; }
  .reasons li {
    display: flex; gap: 10px; font-size: 13px; color: var(--t2);
    line-height: 1.5; margin-bottom: 8px;
  }
  .ri { font-size: 14px; flex-shrink: 0; margin-top: 1px; }

  .evidence-box {
    background: var(--bg); border-radius: 8px;
    padding: 10px 14px; font-size: 12px; color: var(--t3); line-height: 1.6;
  }
  .evidence-box strong { color: var(--t2); }

  .bcard-meta {
    display: flex; gap: 14px; flex-wrap: wrap;
    margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--bdr);
    font-size: 11px; color: var(--t3);
  }

  /* CHECKLIST */
  .checklist-card {
    background: var(--gp); border: 1px solid #C3E6A0;
    border-radius: var(--rl); padding: 20px 24px; margin-bottom: 24px;
  }
  .checklist-title { font-size: 15px; font-weight: 800; color: var(--gd); margin-bottom: 14px; }
  .checklist-grid  { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .check-item { display: flex; gap: 8px; font-size: 13px; color: var(--t2); align-items: flex-start; }
  .ctick { color: var(--safe); font-weight: 700; flex-shrink: 0; }

  /* LINE CTA */
  .line-alert {
    background: #F0FDF4; border: 1px solid #BBF7D0;
    border-radius: var(--rl); padding: 20px 24px;
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  }
  .line-ico {
    width: 44px; height: 44px; background: #06C755;
    border-radius: 10px; display: flex; align-items: center;
    justify-content: center; color: white; font-size: 22px;
    font-weight: 900; flex-shrink: 0;
  }
  .line-tb { flex: 1; }
  .line-t  { font-size: 14px; font-weight: 800; color: #14532D; margin-bottom: 3px; }
  .line-s  { font-size: 12px; color: #166534; }
  .btnline {
    background: #06C755; color: white; border: none; border-radius: 8px;
    padding: 10px 20px; font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: var(--f); flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .checklist-grid { grid-template-columns: 1fr; }
    .criteria-grid  { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<Nav active="blacklist" />
<div class="wrap">

  <div class="page-hero">
    <h1 data-i18n="warning_page.title">โบรกเกอร์ที่ควรระวัง</h1>
    <p data-i18n="warning_page.subtitle">รายชื่อโบรกเกอร์ที่ทีมซุปเต่าไม่แนะนำ — ทุก entry มีหลักฐานอ้างอิงจากแหล่งที่ตรวจสอบได้ ไม่ใช่ความเห็นส่วนตัว</p>
  </div>

  <!-- LEGAL DISCLAIMER -->
  <div class="warn-box" style="margin-bottom:24px">
    <strong>หมายเหตุ:</strong> ข้อมูลในหน้านี้อ้างอิงจากข้อเท็จจริงที่ตรวจสอบได้ เช่น
    สถานะใบอนุญาตจาก regulator ที่เกี่ยวข้อง และรายงานจากหน่วยงานกฎหมายที่มีการเปิดเผยต่อสาธารณะ
    TurtlePip ไม่ได้กล่าวหาการกระทำผิดกฎหมายใดๆ นอกเหนือจากที่หน่วยงานทางการได้ดำเนินการแล้ว
  </div>

  <!-- CRITERIA -->
  <div class="criteria-box">
    <div class="criteria-title">เกณฑ์การขึ้นรายการ — โบรกจะถูกขึ้นเมื่อมีหลักฐานอย่างน้อย 1 ข้อ</div>
    <div class="criteria-grid">
      <div class="criteria-item"><span class="criteria-tick">1.</span>ไม่มี Tier-1 regulation (ASIC, FCA, CySEC) หรือ license ขาดหาย</div>
      <div class="criteria-item"><span class="criteria-tick">2.</span>มีประวัติ complaint ถอนเงินไม่ได้จากแหล่งที่ตรวจสอบได้</div>
      <div class="criteria-item"><span class="criteria-tick">3.</span>เปลี่ยนทีมบริหารแล้วมีพฤติกรรมเปลี่ยนในทางที่เสียหายต่อลูกค้า</div>
      <div class="criteria-item"><span class="criteria-tick">4.</span>ประกาศหยุดให้บริการ หรือถูก regulator สั่งหยุด</div>
    </div>
  </div>

  <!-- STATUS LEGEND -->
  <div class="legend">
    <div class="legend-item">
      <span class="badge bavoid">หลีกเลี่ยง</span>
      <span>มีหลักฐานปัญหาชัดเจน ไม่แนะนำเด็ดขาด</span>
    </div>
    <div class="legend-item">
      <span class="badge" style="background:#F1F5F9;color:#64748B">หยุดให้บริการ</span>
      <span>ไม่สามารถเทรดได้แล้ว — ไม่ใช่อันตราย แค่ใช้ไม่ได้</span>
    </div>
  </div>

  {entries.map((entry) => (
    <div class={`bcard ${entry.level}`}>
      <div class="bcard-head">
        <div>
          <div class="bcard-name">{entry.name}</div>
          <div class="bcard-reg">{entry.reg}</div>
        </div>
        <span class={`blevel ${entry.level}`}>{entry.levelLabel}</span>
      </div>
      <div class="bcard-body">
        <ul class="reasons">
          {entry.reasons.map((r) => (
            <li><span class="ri">{r.icon}</span>{r.text}</li>
          ))}
        </ul>
        <div class="evidence-box">
          <strong>หลักฐาน:</strong> {entry.evidence}
        </div>
        <div class="bcard-meta">
          {entry.meta.map((m) => <span>{m}</span>)}
        </div>
      </div>
    </div>
  ))}

  <!-- CHECKLIST -->
  <div class="checklist-card">
    <div class="checklist-title">✓ วิธีตรวจสอบโบรกเกอร์ด้วยตัวเองก่อนเปิดบัญชี</div>
    <div class="checklist-grid">
      <div class="check-item"><span class="ctick">✓</span>เช็ค license โดยตรงจาก ASIC / FCA / CySEC website — ไม่เชื่อแค่โลโก้บนเว็บโบรก</div>
      <div class="check-item"><span class="ctick">✓</span>ดูว่า entity ที่ให้บริการคุณเป็น entity เดียวกับที่ถือ license จริงไหม</div>
      <div class="check-item"><span class="ctick">✓</span>ค้น "ชื่อโบรก + withdrawal problem" หรือ "scam" บน Google ดูรีวิวจริง</div>
      <div class="check-item"><span class="ctick">✓</span>ทดสอบถอนเงินก้อนเล็กก่อนเสมอ ก่อนฝากเงินก้อนใหญ่</div>
      <div class="check-item"><span class="ctick">✓</span>เช็คว่าเงินลูกค้าถูก segregate จากเงินบริษัทไหม</div>
      <div class="check-item"><span class="ctick">✓</span>ดูว่าเจ้าของโบรกเปิดเผยข้อมูลชัดเจนไหม มีการเปลี่ยนมือล่าสุดไหม</div>
    </div>
  </div>

  <!-- LINE CTA -->
  <div class="line-alert">
    <div class="line-ico">L</div>
    <div class="line-tb">
      <div class="line-t">รับแจ้งเตือนเมื่อมีโบรกเกอร์น่าสงสัยรายใหม่</div>
      <div class="line-s">ทีมซุปเต่าจะแจ้งทันทีเมื่อมีข่าวสำคัญ — ฟรี ไม่มีค่าใช้จ่าย</div>
    </div>
    <button class="btnline">เพิ่มเพื่อน LINE OA</button>
  </div>

</div>

<Mascot pose="serious" />
<Footer />
</body>
</html>
