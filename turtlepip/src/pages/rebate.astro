---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import xs from '../data/brokers/xs.json';
import xsRebate from '../data/rebates/xs.json';

const xau = xsRebate.rates.find((r) => r.symbol === 'XAUUSD')!;
const btc = xsRebate.rates.find((r) => r.symbol === 'BTCUSD')!;

const tableRange = (vals: number[]) => `$${vals[0].toFixed(2)}–${vals[1].toFixed(2)}`;
const chipRange = (vals: number[]) => {
  const fmt = (n: number) => (Number.isInteger(n) ? n.toString() : n.toFixed(2));
  return `$${fmt(vals[0])}–${fmt(vals[1])}`;
};
const pointsRange = (vals: number[]) => `${vals[0].toLocaleString()}–${vals[1].toLocaleString()}`;

const faqs = [
  {
    q: 'Rebate จะเข้าเมื่อไหร่?',
    a: 'Rebate คำนวณจาก volume การเทรดและจ่ายอัตโนมัติ ไม่ต้อง claim เอง ระยะเวลาขึ้นอยู่กับระบบ XS.com',
  },
  {
    q: 'ต้องเทรด minimum กี่ lot ถึงได้ rebate?',
    a: 'ทุก lot ที่เทรดได้ rebate ไม่มีขั้นต่ำ ไม่ว่าจะเป็น 0.01 lot หรือ 10 lot ก็ได้ cashback เหมือนกัน',
  },
  {
    q: 'ถ้าเทรดขาดทุนก็ได้ rebate ไหม?',
    a: 'ได้ครับ — Rebate คำนวณจาก volume ที่เทรด ไม่ใช่ผลกำไร ดังนั้นไม่ว่า trade จะปิดกำไรหรือขาดทุนก็ได้ cashback เหมือนกัน',
  },
  {
    q: 'ทำไม range rebate ถึงไม่บอกตัวเลขแน่นอน?',
    a: 'Rebate rate ขึ้นอยู่กับ volume รวมของ portfolio ทั้งหมด — ยิ่งเทรดมาก rate ยิ่งดีขึ้น ทีมซุปเต่าจะให้ rate ที่ดีที่สุดที่ทำได้เสมอ',
  },
  {
    q: 'มีค่าธรรมเนียมในการรับ rebate ไหม?',
    a: 'ไม่มีครับ — Rebate ฟรี 100% ไม่มีค่าสมาชิก ไม่มีค่าธรรมเนียม คุณได้รับ cashback เพิ่มโดยไม่เสียอะไร',
  },
  {
    q: 'สามารถใช้กับทุก account type ได้ไหม?',
    a: 'ตารางด้านบนแสดง Standard account — account type อื่นมี rebate rate ต่างกัน ติดต่อทีมซุปเต่าเพื่อสอบถามเพิ่มเติม',
  },
];
---

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>รับ Rebate จาก XS.com — คืนเงินทุก lot ที่เทรด | TurtlePip</title>
<meta name="description" content="รับ cashback คืนทุก lot ที่เทรดกับ XS.com ผ่าน TurtlePip — XAUUSD สูงสุด 6-9 pts/lot อัตโนมัติ ไม่ต้องทำอะไรเพิ่ม">
<link rel="stylesheet" href="/shared.css">
<style>
  /* HERO */
  .rebate-hero {
    background: var(--gd);
    padding: 48px 28px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .rebate-hero::before {
    content: '';
    position: absolute;
    width: 300px; height: 300px;
    background: rgba(255,255,255,0.04);
    border-radius: 50%;
    top: -100px; right: -80px;
  }
  .rebate-hero::after {
    content: '';
    position: absolute;
    width: 200px; height: 200px;
    background: rgba(255,255,255,0.04);
    border-radius: 50%;
    bottom: -60px; left: -40px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.15);
    color: white;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .rebate-hero h1 {
    font-size: 32px;
    font-weight: 800;
    color: white;
    letter-spacing: -.5px;
    line-height: 1.25;
    margin-bottom: 12px;
    position: relative;
  }
  .rebate-hero p {
    font-size: 15px;
    color: rgba(255,255,255,0.8);
    max-width: 520px;
    margin: 0 auto 28px;
    line-height: 1.7;
    position: relative;
  }
  .hero-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }
  .btn-hero-main {
    background: white;
    color: var(--gd);
    border: none;
    border-radius: 10px;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    font-family: var(--f);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn-hero-sub {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 1.5px solid rgba(255,255,255,0.4);
    border-radius: 10px;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--f);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  /* STATS CHIPS */
  .stats-chips {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 20px 28px;
    background: var(--surf);
    border-bottom: 1px solid var(--bdr);
  }
  .stat-chip {
    text-align: center;
    padding: 12px 20px;
    background: var(--bg);
    border-radius: var(--r);
    border: 1px solid var(--bdr);
  }
  .stat-chip-val { font-size: 20px; font-weight: 800; color: var(--gd); font-family: monospace; }
  .stat-chip-label { font-size: 11px; color: var(--t3); margin-top: 2px; }

  /* SECTION */
  .section { max-width: 860px; margin: 0 auto; padding: 40px 28px; }
  .section-title {
    font-size: 22px; font-weight: 800; letter-spacing: -.3px;
    margin-bottom: 6px; color: var(--t1);
  }
  .section-sub { font-size: 13px; color: var(--t2); margin-bottom: 24px; line-height: 1.6; }

  /* HOW IT WORKS */
  .steps-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 40px; }
  .step-card {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: var(--rl);
    padding: 20px;
    text-align: center;
  }
  .step-num {
    width: 36px; height: 36px;
    background: var(--gd); color: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 800;
    margin: 0 auto 12px;
  }
  .step-title { font-size: 13px; font-weight: 700; color: var(--t1); margin-bottom: 6px; }
  .step-text  { font-size: 12px; color: var(--t2); line-height: 1.6; }

  /* REBATE TABLE */
  .rebate-card {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: var(--rl);
    overflow: hidden;
    margin-bottom: 32px;
  }
  .rebate-card-head {
    padding: 14px 20px;
    border-bottom: 1px solid var(--bdr);
    display: flex; align-items: center; justify-content: space-between;
  }
  .rebate-card-title { font-size: 13px; font-weight: 700; color: var(--t1); }
  .rebate-note { font-size: 11px; color: var(--t3); }
  .rtable { width: 100%; border-collapse: collapse; }
  .rtable th {
    padding: 9px 16px;
    font-size: 11px; font-weight: 700; color: var(--t3);
    letter-spacing: .06em; text-transform: uppercase;
    border-bottom: 1px solid var(--bdr);
    background: var(--bg); text-align: left;
  }
  .rtable th.center { text-align: center; }
  .rtable td { padding: 12px 16px; border-bottom: 1px solid var(--bdr); font-size: 13px; color: var(--t2); }
  .rtable td.center { text-align: center; }
  .rtable tr:last-child td { border-bottom: none; }
  .rtable tr:hover td { background: var(--bg); }
  .symbol-name { font-weight: 700; color: var(--t1); }
  .symbol-desc { font-size: 11px; color: var(--t3); margin-top: 1px; }
  .rebate-range {
    font-weight: 800; font-family: monospace;
    color: var(--safe); font-size: 14px;
  }
  .you-get {
    background: var(--gp);
    color: var(--gd);
    font-weight: 800;
    font-family: monospace;
    font-size: 13px;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .popular-badge {
    background: #FEF3C7; color: #92400E;
    font-size: 9px; font-weight: 700;
    padding: 2px 6px; border-radius: 10px;
    margin-left: 6px; vertical-align: middle;
  }
  .table-footer {
    padding: 10px 16px;
    font-size: 11px; color: var(--t3);
    background: var(--bg);
    border-top: 1px solid var(--bdr);
    line-height: 1.6;
  }

  /* CASE CARDS */
  .cases-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
  .case-card {
    border-radius: var(--rl);
    overflow: hidden;
    border: 1px solid var(--bdr);
  }
  .case-head {
    padding: 16px 20px;
    font-size: 14px; font-weight: 800;
    border-bottom: 1px solid var(--bdr);
  }
  .case-card.new .case-head { background: var(--gp); color: var(--gd); }
  .case-card.transfer .case-head { background: #EFF6FF; color: #1D4ED8; }
  .case-body { padding: 20px; background: var(--surf); }
  .case-steps { list-style: none; padding: 0; }
  .case-steps li {
    display: flex; gap: 12px;
    font-size: 13px; color: var(--t2);
    margin-bottom: 14px; line-height: 1.5;
  }
  .case-steps li:last-child { margin-bottom: 0; }
  .case-step-num {
    width: 22px; height: 22px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
    flex-shrink: 0; margin-top: 1px;
  }
  .case-card.new    .case-step-num { background: var(--gp); color: var(--gd); }
  .case-card.transfer .case-step-num { background: #EFF6FF; color: #1D4ED8; }
  .btn-case {
    width: 100%;
    padding: 12px;
    border: none; border-radius: 8px;
    font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: var(--f);
    margin-top: 16px;
    text-decoration: none;
    display: block;
    text-align: center;
  }
  .case-card.new .btn-case { background: var(--gd); color: white; }
  .case-card.transfer .btn-case { background: #1D4ED8; color: white; }

  /* EMAIL TEMPLATE BOX */
  .email-box {
    background: var(--bg);
    border: 1px solid var(--bdr);
    border-radius: var(--r);
    padding: 16px;
    font-size: 12px;
    color: var(--t2);
    line-height: 1.8;
    margin-top: 12px;
    font-family: monospace;
  }
  .copy-btn {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--f);
    color: var(--t2);
    margin-top: 10px;
    width: 100%;
  }
  .copy-btn:active { background: var(--gp); color: var(--gd); }

  /* FAQ */
  .faq-card {
    background: var(--surf);
    border: 1px solid var(--bdr);
    border-radius: var(--rl);
    overflow: hidden;
    margin-bottom: 32px;
  }
  .faq-item { border-bottom: 1px solid var(--bdr); }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    padding: 14px 20px;
    font-size: 13px; font-weight: 700; color: var(--t1);
    cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
  }
  .faq-q:hover { background: var(--bg); }
  .faq-a {
    padding: 0 20px 14px;
    font-size: 13px; color: var(--t2);
    line-height: 1.75; display: none;
  }
  .faq-a.open { display: block; }
  .faq-arrow { font-size: 12px; color: var(--t3); transition: transform 0.2s; }
  .faq-arrow.open { transform: rotate(180deg); }

  /* CTA BOTTOM */
  .cta-bottom {
    background: var(--gd);
    border-radius: var(--rl);
    padding: 32px;
    text-align: center;
    margin-bottom: 0;
  }
  .cta-bottom h2 { font-size: 22px; font-weight: 800; color: white; margin-bottom: 8px; }
  .cta-bottom p  { font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 20px; }
  .btn-cta-big {
    background: white; color: var(--gd);
    border: none; border-radius: 10px;
    padding: 14px 32px; font-size: 14px; font-weight: 800;
    cursor: pointer; font-family: var(--f);
    text-decoration: none; display: inline-block;
  }

  @media (max-width: 700px) {
    .rebate-hero h1 { font-size: 24px; }
    .steps-grid { grid-template-columns: 1fr; }
    .cases-grid { grid-template-columns: 1fr; }
    .stats-chips { gap: 8px; }
    .stat-chip { padding: 10px 14px; }
    .section { padding: 28px 16px; }
  }

.tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.tbl-scroll .rtable { min-width: 480px; }
</style>
</head>
<body>

<Nav active="rebate" />

<!-- HERO -->
<div class="rebate-hero">
  <div class="hero-tag">Cashback อัตโนมัติ — ทุก lot ที่เทรด</div>
  <h1>เทรด XS.com ผ่านเรา<br>รับ Rebate คืนทุก lot</h1>
  <p>ไม่ว่าจะกำไรหรือขาดทุน — ทีมซุปเต่าคืน cashback ให้คุณทุกครั้งที่เทรด อัตโนมัติ ไม่ต้องทำอะไรเพิ่ม</p>
  <div class="hero-btns">
    <a href={xs.affiliateUrl} target="_blank" rel="nofollow noopener sponsored" class="btn-hero-main">
      สมัครรับ Rebate เลย →
    </a>
    <a href="#how-it-works" class="btn-hero-sub">ดูวิธีการ</a>
  </div>
</div>

<!-- STATS -->
<div class="stats-chips">
  <div class="stat-chip">
    <div class="stat-chip-val">{chipRange(xau.cashbackUsd)}</div>
    <div class="stat-chip-label">XAUUSD / lot</div>
  </div>
  <div class="stat-chip">
    <div class="stat-chip-val">{chipRange(btc.cashbackUsd)}</div>
    <div class="stat-chip-label">BTCUSD / lot</div>
  </div>
  <div class="stat-chip">
    <div class="stat-chip-val">อัตโนมัติ</div>
    <div class="stat-chip-label">ไม่ต้อง claim เอง</div>
  </div>
  <div class="stat-chip">
    <div class="stat-chip-val">ทุก lot</div>
    <div class="stat-chip-label">กำไรหรือขาดทุนก็ได้</div>
  </div>
</div>

<div class="section">

  <!-- HOW IT WORKS -->
  <div id="how-it-works">
    <div class="section-title">วิธีรับ Rebate</div>
    <div class="section-sub">ง่ายมาก — สมัครครั้งเดียว รับเงินคืนทุก lot ตลอดไป</div>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">1</div>
        <div class="step-title">สมัคร XS.com ผ่าน TurtlePip</div>
        <div class="step-text">คลิก link ของเราเพื่อเปิดบัญชี XS.com — account จะอยู่ใต้ IB ของ TurtlePip อัตโนมัติ</div>
      </div>
      <div class="step-card">
        <div class="step-num">2</div>
        <div class="step-title">เทรดตามปกติ</div>
        <div class="step-text">เทรด XAU/USD, EUR/USD หรือ symbol อื่นๆ ตามสไตล์ของคุณ ไม่ต้องเปลี่ยนอะไร</div>
      </div>
      <div class="step-card">
        <div class="step-num">3</div>
        <div class="step-title">รับ Rebate อัตโนมัติ</div>
        <div class="step-text">Cashback คำนวณและจ่ายให้อัตโนมัติ ไม่ต้อง claim ไม่ต้องทำอะไรเพิ่ม</div>
      </div>
    </div>
  </div>

  <!-- REBATE TABLE -->
  <div class="section-title">อัตรา Rebate — Standard Account</div>
  <div class="broker-tabs" style="display:flex;gap:8px;margin:12px 0 16px;flex-wrap:wrap;">
    <button class="btab on" style="padding:8px 18px;border-radius:8px;border:1.5px solid var(--gd);background:var(--gd);color:white;font-size:13px;font-weight:700;font-family:var(--f);cursor:pointer;">XS.com</button>
    <button class="btab" style="padding:8px 18px;border-radius:8px;border:1px solid var(--bdr);background:var(--surf);color:var(--t3);font-size:13px;font-weight:600;font-family:var(--f);cursor:not-allowed;" disabled>Pepperstone — เร็วๆ นี้</button>
    <button class="btab" style="padding:8px 18px;border-radius:8px;border:1px solid var(--bdr);background:var(--surf);color:var(--t3);font-size:13px;font-weight:600;font-family:var(--f);cursor:not-allowed;" disabled>Exness — เร็วๆ นี้</button>
  </div>
  <div class="section-sub">ตัวเลขด้านล่างคือ cashback ที่คุณจะได้รับจริงต่อ 1 lot — จ่ายอัตโนมัติ ไม่ต้อง claim</div>

  <div class="rebate-card">
    <div class="rebate-card-head">
      <span class="rebate-card-title">XS.com — {xsRebate.account}</span>
      <span class="rebate-note">อัปเดต พ.ค. 2026</span>
    </div>
    <div class="tbl-scroll"><table class="rtable">
      <thead>
        <tr>
          <th>Symbol</th>
          <th class="center">Cashback / lot</th>
          <th class="center">หน่วย points</th>
        </tr>
      </thead>
      <tbody>
        {xsRebate.rates.map((rate) => (
          <tr>
            <td>
              <div class="symbol-name">{rate.name} {rate.popular && <span class="popular-badge">ยอดนิยม</span>}</div>
              <div class="symbol-desc">{rate.desc}</div>
            </td>
            <td class="center"><span class="rebate-range">{tableRange(rate.cashbackUsd)}</span></td>
            <td class="center"><span class="you-get">{pointsRange(rate.points)} pts</span></td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <div class="table-footer">
      Standard Account เท่านั้น · Range ขึ้นอยู่กับ volume การเทรด · Symbol อื่นๆ สอบถามทีมซุปเต่า · ค่าโดยประมาณ อาจแตกต่างตามสภาวะตลาด
    </div>
  </div>

  <!-- CASES -->
  <div class="section-title">เริ่มต้นรับ Rebate</div>
  <div class="section-sub">เลือกตามสถานการณ์ของคุณ</div>

  <div class="cases-grid">

    <!-- NEW ACCOUNT -->
    <div class="case-card new">
      <div class="case-head">ยังไม่มี XS.com account</div>
      <div class="case-body">
        <ul class="case-steps">
          <li>
            <div class="case-step-num">1</div>
            <div>คลิก link ด้านล่างเพื่อเปิดบัญชี XS.com — สมัครตามปกติ</div>
          </li>
          <li>
            <div class="case-step-num">2</div>
            <div>Verify เอกสาร และฝากเงินเข้าบัญชี</div>
          </li>
          <li>
            <div class="case-step-num">3</div>
            <div>เทรดได้เลย — Rebate จะเข้าอัตโนมัติทุก lot</div>
          </li>
        </ul>
        <a href={xs.affiliateUrl} target="_blank" rel="nofollow noopener sponsored" class="btn-case">
          สมัคร XS.com รับ Rebate →
        </a>
        <p style="font-size:10px;color:var(--t3);margin-top:8px;text-align:center;">Sponsored · การเทรด CFD มีความเสี่ยงสูง</p>
      </div>
    </div>

    <!-- TRANSFER -->
    <div class="case-card transfer">
      <div class="case-head">มี XS.com account อยู่แล้ว</div>
      <div class="case-body">
        <ul class="case-steps">
          <li>
            <div class="case-step-num">1</div>
            <div>ส่ง email ขอย้าย IB มาใต้ TurtlePip — ใช้ template ด้านล่าง</div>
          </li>
          <li>
            <div class="case-step-num">2</div>
            <div>ส่งไปที่ <strong>partner@xs.com</strong> — รอ 24-48 ชั่วโมง</div>
          </li>
          <li>
