---
import ClarityHead from '../components/ClarityHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';
import xs from '../data/brokers/xs.json';
import xsRebate from '../data/rebates/xs.json';

const xau = xsRebate.rates.find((r) => r.symbol === 'XAUUSD')!;
const btc = xsRebate.rates.find((r) => r.symbol === 'BTCUSD')!;

const fmtNum = (n: number) => (Number.isInteger(n) ? n.toString() : n.toFixed(2));
const tableRange = (vals: number[]) => `$${fmtNum(vals[0])}–${fmtNum(vals[1])}`;
const chipRange = (vals: number[]) => `$${fmtNum(vals[0])}–${fmtNum(vals[1])}`;
const pointsRange = (vals: number[]) => `${vals[0].toLocaleString()}–${vals[1].toLocaleString()}`;

const faqs = [
  { q: 'Rebate จะเข้าเมื่อไหร่?', a: 'XS.com จ่าย rebate อัตโนมัติทุก lot ไม่ต้อง claim Pepperstone และ Exness จ่ายหลังจาก activate กับทีมซุปเต่าแล้ว ระยะเวลาขึ้นกับแต่ละโบรก' },
  { q: 'ต้องเทรด minimum กี่ lot ถึงได้ rebate?', a: 'ทุก lot ที่เทรดได้ rebate ไม่มีขั้นต่ำ ไม่ว่าจะเป็น 0.01 lot หรือ 100 lot ก็ได้ cashback เหมือนกัน' },
  { q: 'ถ้าเทรดขาดทุนก็ได้ rebate ไหม?', a: 'ได้ครับ — Rebate คำนวณจาก volume ที่เทรด ไม่ใช่ผลกำไร ดังนั้นไม่ว่า trade จะปิดกำไรหรือขาดทุนก็ได้ cashback เหมือนกัน' },
  { q: 'ทำไม range rebate ถึงไม่บอกตัวเลขแน่นอน?', a: 'XS.com: rate ขึ้นกับ volume tier ยิ่งเทรดมาก rate ยิ่งดี Pepperstone: rate คงที่ตาม account type Exness: rate คงที่ตาม account type ทีมซุปเต่าให้ rate ดีที่สุดที่ทำได้เสมอ' },
  { q: 'มีค่าธรรมเนียมในการรับ rebate ไหม?', a: 'ไม่มีครับ — Rebate ฟรี 100% ไม่มีค่าสมาชิก ไม่มีค่าธรรมเนียม คุณได้รับ cashback เพิ่มโดยไม่เสียอะไร' },
  { q: 'สามารถใช้กับทุก account type ได้ไหม?', a: 'ได้ แต่ rate ต่างกันตาม account type ดูตารางอัตราในแต่ละโบรกด้านล่าง หรือติดต่อทีมซุปเต่าผ่าน LINE OA เพื่อสอบถาม' },
  { q: 'Pepperstone rebate ต้องทำอะไรบ้าง?', a: 'ถ้ายังไม่มีบัญชี — สมัครผ่านลิงค์ TurtlePip แล้ว rebate จะเข้าอัตโนมัติทุก lot ถ้ามีบัญชีอยู่แล้ว — ติดต่อทีมซุปเต่าผ่าน LINE OA เพื่อย้าย IB มาอยู่ใต้เรา ไม่มีค่าใช้จ่าย' },
  { q: 'มี Exness account อยู่แล้ว ย้าย IB ได้ไหม?', a: 'ได้ — Exness ให้เปลี่ยน Partner ได้เองใน my.exness.com โดยตรง ไปที่ การตั้งค่า → Partner แล้วกรอก Partner Code: j9uv5xe0m4 ไม่ต้องส่ง email ไม่ต้องรอ approval ทำได้ทันที' },
  { q: 'มี Pepperstone account อยู่แล้ว ย้าย IB ได้ไหม?', a: 'ได้ — แต่ต้องติดต่อทีมซุปเต่าผ่าน LINE OA ก่อน เราจะส่ง request ไปที่ Pepperstone เพื่อย้าย IB ให้ ไม่มีค่าใช้จ่าย ไม่กระทบยอดเงินหรือ position ที่เปิดอยู่' },
  { q: 'Exness rebate กับ XS rebate ต่างกันยังไง?', a: 'XS.com rebate rate สูงกว่าสำหรับ XAUUSD ($3–5 vs ~$2.56) แต่ Exness มีข้อดีที่ spread XAUUSD ต่ำกว่าและถอนเงินอัตโนมัติ ถ้าเทรด high volume XS คุ้มกว่า ถ้าเน้นถอนเงินเร็วหรือ leverage สูง Exness ดีกว่า' },
];
---

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>รับ Rebate จาก XS.com · Pepperstone · Exness — คืนเงินทุก lot | TurtlePip</title>
<meta name="description" content="รับ cashback คืนทุก lot จาก XS.com, Pepperstone และ Exness ผ่านทีมซุปเต่า — XAUUSD สูงสุด $5/lot ไม่ว่าจะกำไรหรือขาดทุน">
<link rel="canonical" href="https://turtlepip.com/rebate">
<link rel="alternate" hreflang="th" href="https://turtlepip.com/rebate">
<link rel="alternate" hreflang="en" href="https://turtlepip.com/rebate">
<link rel="alternate" hreflang="x-default" href="https://turtlepip.com/rebate">
<link rel="stylesheet" href="/shared.css">
<style>
  /* HERO */
  .rebate-hero { background:var(--gd); padding:48px 28px; text-align:center; position:relative; overflow:hidden; }
  .rebate-hero::before { content:''; position:absolute; width:300px; height:300px; background:rgba(255,255,255,0.04); border-radius:50%; top:-100px; right:-80px; }
  .rebate-hero::after  { content:''; position:absolute; width:200px; height:200px; background:rgba(255,255,255,0.04); border-radius:50%; bottom:-60px; left:-40px; }
  .hero-tag { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.15); color:white; font-size:12px; font-weight:700; padding:5px 14px; border-radius:20px; margin-bottom:16px; }
  .rebate-hero h1 { font-size:32px; font-weight:800; color:white; letter-spacing:-.5px; line-height:1.25; margin-bottom:12px; position:relative; }
  .rebate-hero p { font-size:15px; color:rgba(255,255,255,0.82); max-width:520px; margin:0 auto 28px; line-height:1.7; position:relative; }
  .hero-btns { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; position:relative; }
  .btn-hero-main { background:white; color:var(--gd); border:none; border-radius:10px; padding:14px 28px; font-size:14px; font-weight:800; cursor:pointer; font-family:var(--f); text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
  .btn-hero-sub  { background:rgba(255,255,255,0.15); color:white; border:1.5px solid rgba(255,255,255,0.4); border-radius:10px; padding:14px 28px; font-size:14px; font-weight:600; cursor:pointer; font-family:var(--f); text-decoration:none; display:inline-flex; align-items:center; }

  /* FACTS GRID */
  .facts-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; padding:20px 28px; background:var(--surf); border-bottom:1px solid var(--bdr); }
  .fact-card { text-align:center; padding:14px 10px; background:var(--bg); border-radius:var(--r); border:1px solid var(--bdr); }
  .fact-num { font-size:20px; font-weight:800; color:var(--gd); font-family:monospace; margin-bottom:3px; }
  .fact-label { font-size:11px; color:var(--t3); line-height:1.4; }

  /* SECTION */
  .section { max-width:900px; margin:0 auto; padding:40px 28px; }
  .section-h2 { font-size:22px; font-weight:800; letter-spacing:-.3px; margin-bottom:14px; color:var(--t1); scroll-margin-top:80px; }
  .section-sub { font-size:13px; color:var(--t2); margin-bottom:20px; line-height:1.6; }

  /* HOW IT WORKS */
  .steps-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:32px; }
  .step-card { background:var(--surf); border:1px solid var(--bdr); border-radius:var(--rl); padding:20px; text-align:center; }
  .step-num { width:36px; height:36px; background:var(--gd); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:800; margin:0 auto 12px; }
  .step-title { font-size:13px; font-weight:700; color:var(--t1); margin-bottom:6px; }
  .step-text  { font-size:12px; color:var(--t2); line-height:1.6; }

  /* REBATE TABLE */
  .rebate-card { background:var(--surf); border:1px solid var(--bdr); border-radius:var(--rl); overflow:hidden; margin-bottom:24px; }
  .rebate-card-head { padding:14px 20px; border-bottom:1px solid var(--bdr); display:flex; align-items:center; justify-content:space-between; }
  .rebate-card-title { font-size:13px; font-weight:700; color:var(--t1); }
  .rebate-note { font-size:11px; color:var(--t3); }
  .rtable { width:100%; border-collapse:collapse; }
  .rtable th { padding:9px 16px; font-size:11px; font-weight:700; color:var(--t3); letter-spacing:.06em; text-transform:uppercase; border-bottom:1px solid var(--bdr); background:var(--bg); text-align:left; }
  .rtable th.center { text-align:center; }
  .rtable td { padding:12px 16px; border-bottom:1px solid var(--bdr); font-size:13px; color:var(--t2); }
  .rtable td.center { text-align:center; }
  .rtable tr:last-child td { border-bottom:none; }
  .rtable tr:hover td { background:var(--bg); }
  .symbol-name { font-weight:700; color:var(--t1); }
  .symbol-desc { font-size:11px; color:var(--t3); margin-top:1px; }
  .rebate-range { font-weight:800; font-family:monospace; color:var(--safe); font-size:14px; }
  .you-get { background:var(--gp); color:var(--gd); font-weight:800; font-family:monospace; font-size:13px; padding:3px 10px; border-radius:20px; white-space:nowrap; }
  .popular-badge { background:#FEF3C7; color:#92400E; font-size:9px; font-weight:700; padding:2px 6px; border-radius:10px; margin-left:6px; vertical-align:middle; }
  .table-footer { padding:10px 16px; font-size:11px; color:var(--t3); background:var(--bg); border-top:1px solid var(--bdr); line-height:1.6; }

  /* CASE CARDS */
  .cases-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:32px; }
  .case-card { border-radius:var(--rl); overflow:hidden; border:1px solid var(--bdr); }
  .case-head { padding:16px 20px; font-size:14px; font-weight:800; border-bottom:1px solid var(--bdr); }
  .case-card.new .case-head { background:var(--gp); color:var(--gd); }
  .case-card.transfer .case-head { background:#EFF6FF; color:#1D4ED8; }
  .case-body { padding:20px; background:var(--surf); }
  .case-steps { list-style:none; padding:0; }
  .case-steps li { display:flex; gap:12px; font-size:13px; color:var(--t2); margin-bottom:14px; line-height:1.5; }
  .case-steps li:last-child { margin-bottom:0; }
  .case-step-num { width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; margin-top:1px; }
  .case-card.new .case-step-num { background:var(--gp); color:var(--gd); }
  .case-card.transfer .case-step-num { background:#EFF6FF; color:#1D4ED8; }
  .btn-case { width:100%; padding:12px; border:none; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; font-family:var(--f); margin-top:16px; text-decoration:none; display:block; text-align:center; }
  .case-card.new .btn-case { background:var(--gd); color:white; }
  .case-card.transfer .btn-case { background:#1D4ED8; color:white; }

  /* EMAIL */
  .email-box { background:var(--bg); border:1px solid var(--bdr); border-radius:var(--r); padding:16px; font-size:12px; color:var(--t2); line-height:1.8; margin-top:12px; font-family:monospace; }
  .copy-btn { background:var(--surf); border:1px solid var(--bdr); border-radius:6px; padding:6px 12px; font-size:11px; font-weight:600; cursor:pointer; font-family:var(--f); color:var(--t2); margin-top:10px; width:100%; }
  .copy-btn:active { background:var(--gp); color:var(--gd); }

  /* FAQ */
  .faq-card { background:var(--surf); border:1px solid var(--bdr); border-radius:var(--rl); overflow:hidden; margin-bottom:32px; }
  .faq-item { border-bottom:1px solid var(--bdr); }
  .faq-item:last-child { border-bottom:none; }
  .faq-q { padding:14px 20px; font-size:13px; font-weight:700; color:var(--t1); cursor:pointer; display:flex; align-items:center; justify-content:space-between; }
  .faq-q:hover { background:var(--bg); }
  .faq-a { padding:0 20px 14px; font-size:13px; color:var(--t2); line-height:1.75; display:none; }
  .faq-a.open { display:block; }
  .faq-arrow { font-size:12px; color:var(--t3); transition:transform 0.2s; }
  .faq-arrow.open { transform:rotate(180deg); }

  /* CTA BOTTOM */
  .cta-bottom { background:var(--gd); border-radius:var(--rl); padding:32px; text-align:center; margin-bottom:0; }
  .cta-bottom h2 { font-size:22px; font-weight:800; color:white; margin-bottom:8px; }
  .cta-bottom p  { font-size:13px; color:rgba(255,255,255,0.75); margin-bottom:20px; }
  .btn-cta-big { background:white; color:var(--gd); border:none; border-radius:10px; padding:14px 32px; font-size:14px; font-weight:800; cursor:pointer; font-family:var(--f); text-decoration:none; display:inline-block; }

  /* BROKER SECTION ANCHOR */
  .broker-section-head { display:flex; align-items:center; gap:14px; margin-bottom:20px; border-bottom:2px solid var(--bdr); padding-bottom:14px; }
  .broker-section-logo { width:40px; height:40px; border-radius:8px; overflow:hidden; border:1px solid var(--bdr); object-fit:contain; }

  @media (max-width:700px) {
    .rebate-hero h1 { font-size:24px; }
    .steps-grid { grid-template-columns:1fr; }
    .cases-grid { grid-template-columns:1fr; }
    .facts-grid { padding:14px; }
    .section { padding:28px 16px; }
  }
  .tbl-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  .tbl-scroll table { min-width:400px; }
</style>
<ClarityHead />
</head>
<body>

<Nav active="rebate" />

<!-- SECTION 1 — HERO -->
<div class="rebate-hero">
  <div class="hero-tag">Cashback · คืนเงินทุก lot</div>
  <h1 data-i18n="rebate.title">รับ Rebate จากโบรกที่คุณเทรดอยู่</h1>
