<Footer />

<script>
function toggleFaq(el: HTMLElement) {
  const ans = el.nextElementSibling as HTMLElement;
  const arrow = el.querySelector('.faq-arrow');
  ans.classList.toggle('open');
  arrow?.classList.toggle('open');
}
// @ts-expect-error - exposed for inline onclick handler
window.toggleFaq = toggleFaq;

function copyEmail() {
  const text = (document.getElementById('emailTemplate') as HTMLElement).innerText;
  navigator.clipboard.writeText(text).then(function() {
    const btn = document.querySelector('.copy-btn') as HTMLElement;
    btn.textContent = 'Copied!';
    setTimeout(function(){ btn.textContent = 'Copy Email Template'; }, 2000);
  });
}
// @ts-expect-error - exposed for inline onclick handler
window.copyEmail = copyEmail;
</script>
