</div>

<!-- FACTS GRID -->
<div class="facts-grid">
  <div class="fact-card">
    <div class="fact-num">$3–5</div>
    <div class="fact-label">XS.com XAUUSD / lot</div>
  </div>
  <div class="fact-card">
    <div class="fact-num">$1.8–5</div>
    <div class="fact-label">Pepperstone XAUUSD / lot</div>
  </div>
  <div class="fact-card">
    <div class="fact-num">~$2.56</div>
    <div class="fact-label">Exness XAUUSD / lot (Standard)</div>
  </div>
  <div class="fact-card">
    <div class="fact-num">ทุก lot</div>
    <div class="fact-label">ทุก lot ที่เทรด</div>
  </div>
</div>

<div class="section">

  <!-- SECTION 2 — BROKER COMPARISON CARDS -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin:0 0 36px">

    <div class="data-card" style="padding:20px;text-align:center">
      <img src="/logos/xs.webp" alt="XS.com" width="80" height="36" style="height:36px;margin-bottom:12px;object-fit:contain" loading="lazy">
      <div style="font-size:13px;font-weight:700;color:var(--t1);margin-bottom:4px">XS.com</div>
      <div style="font-size:22px;font-weight:800;color:var(--gd);margin:8px 0">$3–5<span style="font-size:13px;font-weight:400">/lot XAU</span></div>
      <span class="badge bsafe" style="display:inline-block;margin-bottom:12px">อัตโนมัติ ไม่ต้อง claim</span>
      <a href="#xs" class="btn-cta" style="display:block;font-size:13px;padding:10px">รับ Rebate XS →</a>
    </div>

    <div class="data-card" style="padding:20px;text-align:center">
      <img src="/logos/pepperstone.webp" alt="Pepperstone" width="80" height="36" style="height:36px;margin-bottom:12px;object-fit:contain" loading="lazy">
      <div style="font-size:13px;font-weight:700;color:var(--t1);margin-bottom:4px">Pepperstone</div>
      <div style="font-size:22px;font-weight:800;color:var(--gd);margin:8px 0">$1.8–5<span style="font-size:13px;font-weight:400">/lot XAU</span></div>
      <span class="badge bwarn" style="display:inline-block;margin-bottom:12px">มีบัญชีอยู่แล้ว ย้ายได้</span>
      <a href="#pepperstone" class="btn-cta" style="display:block;font-size:13px;padding:10px">รับ Rebate Pepperstone →</a>
    </div>

    <div class="data-card" style="padding:20px;text-align:center">
      <img src="/logos/exness.webp" alt="Exness" width="80" height="36" style="height:36px;margin-bottom:12px;object-fit:contain" loading="lazy">
      <div style="font-size:13px;font-weight:700;color:var(--t1);margin-bottom:4px">Exness</div>
      <div style="font-size:22px;font-weight:800;color:var(--gd);margin:8px 0">~$2.56<span style="font-size:13px;font-weight:400">/lot XAU</span></div>
      <span class="badge bsafe" style="display:inline-block;margin-bottom:12px">ย้าย IB ได้จาก Portal</span>
      <a href="#exness" class="btn-cta" style="display:block;font-size:13px;padding:10px">รับ Rebate Exness →</a>
    </div>

  </div>

  <!-- SECTION 3 — COMBINED RATE TABLE -->
  <h2 class="section-h2">อัตรา Rebate เปรียบเทียบ — Standard Account</h2>
  <div class="data-card">
    <div class="tbl-scroll">
      <table class="article-table">
        <thead>
          <tr>
            <th>Symbol</th>
            <th>XS.com</th>
            <th>Pepperstone</th>
            <th>Exness</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>XAU/USD (ทอง)</strong></td>
            <td style="color:var(--gd);font-weight:700">{tableRange(xau.cashbackUsd)}/lot</td>
            <td style="color:var(--gd);font-weight:700">$1.8–5/lot</td>
            <td style="color:var(--gd);font-weight:700">~$2.56/lot</td>
          </tr>
          <tr>
            <td>EUR/USD</td>
            <td>$1–3/lot</td>
            <td>~$1–2/lot</td>
            <td>~$0.80/lot</td>
          </tr>
          <tr>
            <td>BTC/USD</td>
            <td>{tableRange(btc.cashbackUsd)}/lot</td>
            <td>—</td>
            <td>—</td>
          </tr>
          <tr>
            <td>วิธีรับ</td>
            <td>อัตโนมัติ</td>
            <td>ติดต่อ LINE</td>
            <td>ติดต่อ LINE</td>
          </tr>
          <tr>
            <td>มีบัญชีอยู่แล้ว</td>
            <td>ย้าย IB ได้</td>
            <td>ย้ายได้ผ่าน LINE</td>
            <td>ต้องสมัครใหม่</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <p style="font-size:11px;color:var(--t3);margin-top:-12px;margin-bottom:8px">Standard Account · Exness XAUUSD ~16 pts avg · Range ขึ้นกับ volume · อัปเดต มิ.ย. 2026</p>
  <p class="rebate-disclaimer">Rebate คือส่วนหนึ่งของค่าคอมมิชชั่นที่ TurtlePip ได้รับจากโบรกในฐานะ IB (Introducing Broker) และนำมาแบ่งคืนให้ผู้ใช้ — ไม่ใช่ผลตอบแทนการลงทุน ไม่ได้รับประกันกำไร และไม่ลดความเสี่ยงในการเทรด</p>

  <!-- ===================== SECTION 4a — XS.COM ===================== -->
  <div id="xs">
    <div class="broker-section-head">
      <img src="/logos/xs.webp" alt="XS.com" width="60" height="60" class="broker-section-logo" loading="lazy">
      <div>
        <h2 class="section-h2" style="margin-bottom:2px">XS.com — รับ Rebate</h2>
        <span class="badge bsafe" style="font-size:11px">อัตโนมัติ ทุก lot</span>
      </div>
