<link rel="stylesheet" href="/shared.css">
<style>
  .article-wrap { max-width: 760px; margin: 0 auto; padding: 24px 20px; }
  .breadcrumb { font-size: 12px; color: var(--t3); margin-bottom: 20px; }
  .breadcrumb a { color: var(--t3); text-decoration: none; }

  /* ARTICLE HEADER */
  .article-tag {
    display: inline-block;
    font-size: 10px; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--avoid); margin-bottom: 10px;
  }
  .article-title {
    font-size: 26px; font-weight: 800;
    letter-spacing: -.4px; line-height: 1.3;
    color: var(--t1); margin-bottom: 12px;
  }
  .article-meta {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; color: var(--t3);
    margin-bottom: 20px; flex-wrap: wrap;
  }
  .meta-author { font-weight: 600; color: var(--t2); }

  /* ALERT BOX */
  .news-alert {
    background: #FEF2F2; border: 1px solid #FECACA;
    border-radius: var(--rl); padding: 16px 20px; margin-bottom: 28px;
  }
  .news-alert-title { font-size: 13px; font-weight: 700; color: var(--avoid); margin-bottom: 6px; }
  .news-alert-text { font-size: 13px; color: #7F1D1D; line-height: 1.7; }

  /* ARTICLE BODY */
  .article-body h2 {
    font-size: 19px; font-weight: 800;
    letter-spacing: -.3px; color: var(--t1);
    margin: 32px 0 12px; padding-bottom: 8px;
    border-bottom: 2px solid var(--bdr);
  }
  .article-body h3 {
    font-size: 15px; font-weight: 700;
    color: var(--t1); margin: 20px 0 8px;
  }
  .article-body p {
    font-size: 14px; color: var(--t2);
    line-height: 1.85; margin-bottom: 14px;
  }
  .article-body ul { list-style: none; padding: 0; margin-bottom: 14px; }
  .article-body ul li {
    font-size: 14px; color: var(--t2);
    line-height: 1.7; margin-bottom: 8px;
    padding-left: 18px; position: relative;
  }
  .article-body ul li::before {
    content: '·'; position: absolute;
    left: 5px; color: var(--gd); font-weight: 700;
  }
  .article-body strong { color: var(--t1); font-weight: 700; }

  /* HIGHLIGHT BOX */
  .highlight {
    background: var(--gp); border-left: 3px solid var(--gd);
    border-radius: 0 var(--r) var(--r) 0;
    padding: 14px 18px; margin: 20px 0;
    font-size: 13px; color: var(--t2); line-height: 1.7;
  }
  .highlight strong { color: var(--gd); }

  .warn-box {
    background: var(--warnbg); border-left: 3px solid var(--warn);
    border-radius: 0 var(--r) var(--r) 0;
    padding: 14px 18px; margin: 20px 0;
    font-size: 13px; color: #713F12; line-height: 1.7;
  }

  .danger-box {
    background: var(--avoidbg); border-left: 3px solid var(--avoid);
    border-radius: 0 var(--r) var(--r) 0;
    padding: 14px 18px; margin: 20px 0;
    font-size: 13px; color: #7F1D1D; line-height: 1.7;
  }

  /* TABLE */
  .data-card { background: var(--surf); border: 1px solid var(--bdr); border-radius: var(--rl); overflow: hidden; margin: 20px 0; }
  .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .article-table { width: 100%; min-width: 480px; border-collapse: collapse; font-size: 13px; }
  .article-table th { padding: 10px 14px; text-align: left; font-size: 11px; font-weight: 700; color: var(--t3); letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid var(--bdr); background: var(--bg); }
  .article-table td { padding: 12px 14px; border-bottom: 1px solid var(--bdr); color: var(--t2); vertical-align: top; }
  .article-table tr:last-child td { border-bottom: none; }
  .article-table tr.danger td { background: var(--avoidbg); }
  .article-table tr.safe td { background: var(--safebg); }

  /* KEY FACTS BOX */
  .facts-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 12px; margin: 20px 0;
  }
  .fact-card {
    background: var(--bg); border: 1px solid var(--bdr);
    border-radius: var(--r); padding: 14px;
  }
  .fact-num { font-size: 22px; font-weight: 800; font-family: monospace; color: var(--avoid); }
  .fact-label { font-size: 12px; color: var(--t3); margin-top: 3px; }

  /* CHECKLIST */
  .checklist { list-style: none; padding: 0; margin: 16px 0; }
  .checklist li {
    display: flex; gap: 10px;
    font-size: 13px; color: var(--t2);
    margin-bottom: 10px; line-height: 1.5;
  }
  .check-num {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--gd); color: white;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 1px;
  }

  /* CTA */
  .article-cta {
    background: var(--gd); border-radius: var(--rl);
    padding: 24px; margin: 32px 0; text-align: center;
  }
  .article-cta h3 { font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px; }
  .article-cta p { font-size: 13px; color: rgba(255,255,255,0.75); margin-bottom: 16px; }
  .btn-cta {
    display: inline-block; background: white; color: var(--gd);
    border-radius: 9px; padding: 12px 28px;
    font-size: 13px; font-weight: 800; text-decoration: none;
    font-family: var(--f);
  }

  /* DIVIDER */
  .divider { border: none; border-top: 1px solid var(--bdr); margin: 32px 0; }

  /* SOURCE */
  .sources { font-size: 11px; color: var(--t3); line-height: 1.8; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--bdr); }
  .sources a { color: var(--t3); }

  @media (max-width: 600px) {
    .article-title { font-size: 21px; }
    .facts-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
<ClarityHead />
</head>
<body>
<Nav />

<div class="article-wrap">

  <p class="breadcrumb">
    <a href="/">หน้าหลัก</a> ›
    <a href="/blog">บทความ</a> ›
    DSI บุกจับ Forex เถื่อน 2569
  </p>

  <!-- HEADER -->
