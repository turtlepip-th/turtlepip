            <div class="bar-track"><div class="bar-fill" style="width:95%"></div></div>
          </div>
          <div class="score-bar">
            <div class="score-bar-row"><span class="score-bar-label">Thai Support (10%) — ภาษาไทย รองรับครบ</span><span class="score-bar-val" style="color:var(--safe)">8.5</span></div>
            <div class="bar-track"><div class="bar-fill" style="width:85%"></div></div>
          </div>
          <div class="score-bar">
