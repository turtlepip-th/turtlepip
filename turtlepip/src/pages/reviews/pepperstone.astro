<style>
  .page-grid { display: grid; grid-template-columns: 1fr 280px; gap: 24px; }
  .breadcrumb { font-size: 12px; color: var(--t3); margin-bottom: 16px; }
  .breadcrumb a { color: var(--t3); text-decoration: none; }
  .review-hero { background: var(--surf); border: 1px solid var(--bdr); border-radius: var(--rl); padding: 24px; margin-bottom: 8px; display: flex; gap: 20px; align-items: flex-start; }
  .broker-logo-lg { width: 80px; height: 80px; border-radius: 14px; overflow: hidden; flex-shrink: 0; border: 1px solid var(--bdr); background: #0565F8; }
  .broker-logo-lg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-name { font-size: 26px; font-weight: 800; letter-spacing: -.5px; margin: 0; display: inline; }
  .hero-meta { font-size: 12px; color: var(--t2); margin: 6px 0 14px; display: flex; gap: 14px; flex-wrap: wrap; }
  .score-chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip { background: var(--bg); border-radius: 8px; padding: 10px 14px; text-align: center; }
  .chip-label { font-size: 10px; color: var(--t3); font-weight: 600; margin-bottom: 3px; }
  .chip-val { font-size: 20px; font-weight: 800; font-family: monospace; }
  .chip-val.g { color: var(--safe); }
  .btn-aff { display: inline-flex; align-items: center; gap: 6px; background: #0565F8; color: white; border: none; border-radius: 9px; padding: 12px 24px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: var(--f); text-decoration: none; margin-top: 14px; }
  .updated-tag { display: inline-flex; align-items: center; gap: 5px; background: var(--bg); border: 1px solid var(--bdr); border-radius: 6px; padding: 4px 10px; font-size: 11px; color: var(--t3); margin-bottom: 20px; }
  .verdict-box { background: var(--gp); border: 2px solid #C3E6A0; border-radius: var(--rl); padding: 20px; margin-bottom: 20px; }
  .verdict-title { font-size: 15px; font-weight: 800; color: var(--gd); margin-bottom: 8px; }
  .verdict-text { font-size: 13px; color: var(--t2); line-height: 1.75; }
  .highlight-box { background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: var(--r); padding: 14px 16px; margin-bottom: 16px; }
  .highlight-title { font-size: 12px; font-weight: 700; color: #1D4ED8; margin-bottom: 6px; }
  .highlight-text { font-size: 12px; color: #1E40AF; line-height: 1.6; }
  .content h2 { font-size: 18px; font-weight: 800; margin: 28px 0 12px; letter-spacing: -.3px; scroll-margin-top: 80px; color: var(--t1); }
  .content p { font-size: 13px; color: var(--t2); line-height: 1.8; margin-bottom: 12px; }
  .content ul { list-style: none; padding: 0; margin-bottom: 12px; }
  .content ul li { font-size: 13px; color: var(--t2); line-height: 1.6; margin-bottom: 6px; padding-left: 16px; position: relative; }
  .content ul li::before { content: '·'; position: absolute; left: 4px; color: var(--gd); font-weight: 700; }
  .score-bar { margin-bottom: 12px; }
  .score-bar-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .score-bar-label { font-size: 12px; font-weight: 600; color: var(--t1); }
  .score-bar-val { font-size: 13px; font-weight: 800; font-family: monospace; }
  .bar-track { height: 6px; background: var(--bg); border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; background: var(--gd); }
  .score-total-row { border-top: 1px solid var(--bdr); padding-top: 12px; margin-top: 4px; display: flex; justify-content: space-between; align-items: center; }
  .pc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .pc-col { background: var(--bg); border-radius: var(--r); padding: 14px; }
  .pc-title { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 10px; }
  .pc-title.p { color: var(--safe); } .pc-title.c { color: var(--avoid); }
  .pc-item { display: flex; gap: 8px; font-size: 12px; color: var(--t2); margin-bottom: 7px; line-height: 1.45; }
  .pc-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
  .pc-dot.p { background: var(--safe); } .pc-dot.c { background: var(--avoid); }
  .data-card { background: var(--surf); border: 1px solid var(--bdr); border-radius: var(--rl); overflow: hidden; margin-bottom: 20px; }
  .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .data-table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 12px; }
  .data-table th { padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 700; color: var(--t3); letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid var(--bdr); background: var(--bg); }
  .data-table td { padding: 11px 14px; border-bottom: 1px solid var(--bdr); vertical-align: top; color: var(--t2); }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr.rec-row { background: var(--gp); }
  .acc-name { font-weight: 700; font-size: 13px; color: var(--t1); }
  .rec-badge { background: var(--gd); color: white; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; margin-left: 4px; }
  .spread-table th { text-align: center; } .spread-table th:first-child { text-align: left; }
  .spread-table td { text-align: center; font-family: monospace; font-weight: 700; }
  .spread-table td:first-child { text-align: left; font-family: var(--f); font-weight: 600; color: var(--t1); }
  .sp-low { color: var(--safe); } .sp-mid { color: var(--warn); }
  .news-est { display: inline-block; background: #FFFBEB; border: 1px solid #FDE68A; color: var(--warn); font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 4px; font-family: var(--f); }
  .table-note { font-size: 10px; color: var(--t3); padding: 8px 14px; background: var(--bg); border-top: 1px solid var(--bdr); line-height: 1.6; }
  .notice { border-left: 3px solid var(--safe); background: var(--safebg); padding: 12px 16px; margin: 16px 0; font-size: 12px; color: #14532D; line-height: 1.6; }
  .notice-warn { border-left: 3px solid var(--warn); background: var(--warnbg); padding: 12px 16px; margin: 16px 0; font-size: 12px; color: #713F12; line-height: 1.6; }
  .sidebar { display: flex; flex-direction: column; gap: 16px; }
  .s-card { background: var(--surf); border: 1px solid var(--bdr); border-radius: var(--rl); overflow: hidden; }
  .s-head { padding: 11px 15px; border-bottom: 1px solid var(--bdr); font-size: 12px; font-weight: 700; color: var(--t1); }
  .info-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 15px; border-bottom: 1px solid var(--bdr); font-size: 12px; }
  .info-row:last-child { border-bottom: none; }
  .info-label { color: var(--t3); } .info-val { font-weight: 700; text-align: right; font-size: 12px; }
  .toc { list-style: none; padding: 12px 15px; }
  .toc li { margin-bottom: 7px; }
  .toc a { font-size: 12px; color: var(--gd); text-decoration: none; font-weight: 500; }
  .side-compare-row { display: flex; justify-content: space-between; padding: 8px 15px; border-bottom: 1px solid var(--bdr); font-size: 12px; }
  .side-compare-row:last-child { border-bottom: none; }
  .side-compare-row.current { background: var(--gp); }
  a.side-compare-row { text-decoration: none; }
  .steps-list { padding-left: 20px; margin: 16px 0; }
  .steps-list li { font-size: 13px; color: var(--t2); line-height: 1.8; margin-bottom: 8px; }
  .article-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .article-table th { padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 700; color: var(--t3); letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid var(--bdr); background: var(--bg); }
  .article-table td { padding: 10px 14px; border-bottom: 1px solid var(--bdr); color: var(--t2); font-size: 12px; }
  .article-table tr:last-child td { border-bottom: none; }
  @media (max-width: 820px) {
    .page-grid { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .pc-grid { grid-template-columns: 1fr; }
    .review-hero { flex-direction: column; }
  }
</style>
</head>
