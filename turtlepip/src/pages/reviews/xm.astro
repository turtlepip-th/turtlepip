  .neutral-title { font-size: 12px; font-weight: 700; color: #1D4ED8; margin-bottom: 6px; }
  .neutral-text { font-size: 12px; color: #1E40AF; line-height: 1.6; }
  .content h2 { font-size: 18px; font-weight: 800; margin: 28px 0 12px; letter-spacing: -.3px; scroll-margin-top: 80px; color: var(--t1); }
