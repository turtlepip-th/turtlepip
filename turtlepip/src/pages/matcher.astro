    score:6.9, score_spread:6.5, score_platform:7.0, score_support:7.5,
    best_for:['beginner'],
    platforms:['mt','any'], min_deposit:'micro',
    accounts:[
      {name:'Micro', min:5, spread:'จาก 1.6 pip', note:'lot เล็กสุด · เหมาะมือใหม่', rec:false},
      {name:'Standard', min:5, spread:'จาก 1.6 pip', note:'ไม่มี commission', rec:true},
      {name:'XM Zero', min:100, spread:'จาก 0.0 pip + $3.5/lot', note:'spread ต่ำกว่า standard', rec:false},
    ],
    spread:{eurusd:'1.6',xauusd:'0.35',btcusd:'80',eurusd_news:'5-10',xauusd_news:'15-30',btcusd_news:'250-500'},
    why_swing:'Spread สูง · ไม่เหมาะ active swing trader',
    why_tv:'ไม่รองรับ TradingView',
  },
];

function getMatchScore(b: any, style: string, capital: string, platform: string) {
  let score = b.score * 40;
  if (b.best_for.includes(style)) score += 30;
  else score += 5;
  if (b.platforms.includes(platform) || b.platforms.includes('any')) score += 20;
  else score -= 10;
  const capMap: Record<string, number> = {micro:0,small:100,medium:500,large:2000};
  if (b.accounts.some((a: any) => a.min <= capMap[capital]+1)) score += 10;
  return Math.round(score);
}

function getRecommendedAccount(b: any, style: string, capital: string) {
  const capMap: Record<string, number> = {micro:0,small:100,medium:500,large:2000};
  const cap = capMap[capital];
  const affordable = b.accounts.filter((a: any) => a.min <= cap + (cap===0?15:cap*0.5));
  if (affordable.length === 0) return b.accounts;
  if (style === 'scalper' || style === 'news') {
    const ecn = affordable.find((a: any) => a.spread.includes('0.0'));
    if (ecn) return b.accounts.map((a: any) => ({...a, rec: a.name === ecn.name}));
  }
  if (style === 'beginner' || capital === 'micro') {
    const cheap = affordable.reduce((a: any,b: any) => a.min <= b.min ? a : b);
    return b.accounts.map((a: any) => ({...a, rec: a.name === cheap.name}));
  }
  return b.accounts.map((a: any) => ({...a, rec: affordable.includes(a) && a.rec}));
}

function getMatchPct(score: number) {
  const max = 9.5*40+30+20+10;
  return Math.round((score/max)*100);
}

function select(el: HTMLElement, q: number) {
  el.closest('.options')?.querySelectorAll('.opt').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  (answers as any)['q'+q] = el.dataset.val;
  document.getElementById('next'+q)?.classList.add('ready');
}

function goTo(q: number) {
  document.querySelectorAll('.qcard').forEach(c => c.classList.remove('show'));
  document.getElementById('q'+q)?.classList.add('show');
  updateSteps(q);
}

function updateSteps(active: number) {
  for (let i=1;i<=3;i++) {
    const num = document.getElementById('s'+i);
    const lbl = document.getElementById('sl'+i);
    const line = document.getElementById('line'+i);
    if (num) num.className = 'step-num' + (i<active?' done':i===active?' active':'');
    if (lbl) lbl.className = 'step-label' + (i===active?' active':'');
    if (line) line.className = 'step-line' + (i<active?' done':'');
  }
}

function styleLabel(v: string) {
  const map: Record<string,string> = {scalper:'Scalper',daytrader:'Day Trader',swing:'Swing Trader',copy:'Copy Trader',news:'News Trader',beginner:'มือใหม่'};
  return map[v]||v;
}
function capitalLabel(v: string) {
  const map: Record<string,string> = {micro:'< $100',small:'$100-$500',medium:'$500-$2,000',large:'> $2,000'};
  return map[v]||v;
}
function platformLabel(v: string) {
  const map: Record<string,string> = {mt:'MT4/MT5',tv:'TradingView',any:'แนะนำให้'};
  return map[v]||v;
}

function showResults() {
  const {q1:style, q2:capital, q3:platform} = answers;
  if (!style||!capital||!platform) return;

  document.querySelectorAll('.qcard').forEach(c=>c.classList.remove('show'));
  const stepsBar = document.getElementById('stepsBar');
  if (stepsBar) stepsBar.style.display='none';

  const scored = BROKERS.map(b => ({
    ...b,
    matchScore: getMatchScore(b, style, capital, platform),
    accounts: getRecommendedAccount(b, style, capital)
  })).sort((a,b) => b.matchScore - a.matchScore);

  const top3 = scored.slice(0,3);
  const spreadRows = scored.slice(0,5);

  let html = `
  <div class="result-header">
    <h2>ผลการจับคู่โบรกเกอร์</h2>
    <p>จาก 5 โบรกเกอร์ในระบบ — เรียงตามความเหมาะสมสำหรับคุณ</p>
  </div>
  <div class="result-summary">
    <span class="summary-pill">${styleLabel(style)}</span>
    <span class="summary-pill">${capitalLabel(capital)}</span>
    <span class="summary-pill">${platformLabel(platform)}</span>
  </div>`;

  top3.forEach((b, i) => {
    const pct = getMatchPct(b.matchScore);
    const rankClass = i===0?'r1':i===1?'r2':'r3';
    const cardClass = i===0?'rcard rank1':'rcard';
    const why = platform==='tv' ? b.why_tv : b.why_swing;
    const recAcc = b.accounts.find((a: any)=>a.rec);

    html += `
    <div class="${cardClass}">
      ${i===0?`<div class="rank1-tag">⭐ แนะนำอันดับ 1 สำหรับคุณ</div>`:''}
      <div class="rcard-top">
        <div class="rank-badge ${rankClass}">#${i+1}</div>
        <div class="broker-logo-wrap" style="background:${b.logobg}"><img src="${b.logo}" alt="${b.name}"></div>
        <div class="rcard-info">
          <div class="rcard-top-row">
            <span class="rcard-name">${b.name}</span>
            <span class="badge ${b.verdict==='แนะนำ'?'bsafe':'bwarn'}">${b.verdict}</span>
            <span class="match-pct">จับคู่ ${pct}%</span>
          </div>
          <div class="rcard-why">${why}</div>
          <div class="account-rec">
            <div class="account-rec-label">ประเภทบัญชีที่แนะนำ</div>
            <div class="account-tags">
              ${b.accounts.map((a: any)=>`<span class="acc-tag${a.rec?' recommended':''}">${a.name} ${a.rec?'✓':''}<br><span style="font-size:10px;font-weight:400;color:var(--t2)">${a.spread}</span></span>`).join('')}
            </div>
            ${recAcc?`<div style="margin-top:8px;font-size:11px;color:var(--t2)">แนะนำ: <strong>${recAcc.name}</strong> — ${recAcc.note}</div>`:''}
          </div>
        </div>
      </div>
      <div class="rcard-bottom">
        <div class="score-row">
          <div class="score-item"><div class="score-label">TurtlePip Score</div><div class="score-val ${b.score>=8.5?'g':'a'}">${b.score}</div></div>
          <div class="score-item"><div class="score-label">Spread</div><div class="score-val ${b.score_spread>=8.5?'g':'a'}">${b.score_spread}</div></div>
          <div class="score-item"><div class="score-label">Platform</div><div class="score-val ${b.score_platform>=8.5?'g':'a'}">${b.score_platform}</div></div>
          <div class="score-item"><div class="score-label">Support TH</div><div class="score-val ${b.score_support>=8.5?'g':'a'}">${b.score_support}</div></div>
        </div>
        <button class="btn-review">อ่านรีวิวเต็ม →</button>
      </div>
    </div>`;
  });

  // Spread comparison
  html += `
  <div class="spread-section">
    <div class="spread-title">เปรียบเทียบ Spread — Standard Account</div>
    <div class="spread-card">
      <table class="spread-table">
        <thead>
          <tr>
            <th style="text-align:left">โบรกเกอร์</th>
            <th>EUR/USD<br><span style="font-weight:400;text-transform:none;letter-spacing:0">ปกติ / ข่าว</span></th>
            <th>XAU/USD<br><span style="font-weight:400;text-transform:none;letter-spacing:0">ปกติ / ข่าว</span></th>
            <th>BTC/USD<br><span style="font-weight:400;text-transform:none;letter-spacing:0">ปกติ / ข่าว</span></th>
          </tr>
        </thead>
        <tbody>`;

  spreadRows.forEach((b,i) => {
    const eu = parseFloat(b.spread.eurusd);
    const xa = parseFloat(b.spread.xauusd);
    const bt = parseFloat(b.spread.btcusd);
    const euClass = eu<=0.9?'sp-low':eu<=1.2?'sp-mid':'sp-high';
    const xaClass = xa<=0.20?'sp-low':xa<=0.30?'sp-mid':'sp-high';
    const btClass = bt<=50?'sp-low':bt<=65?'sp-mid':'sp-high';
    const isTop = i===0;
    html += `
          <tr${isTop?' class="highlight"':''}>
            <td>${b.name}${isTop?' ⭐':''}</td>
            <td><span class="${euClass}">${b.spread.eurusd}</span> <span class="news-badge">ข่าว ${b.spread.eurusd_news}</span></td>
            <td><span class="${xaClass}">${b.spread.xauusd}</span> <span class="news-badge">ข่าว ${b.spread.xauusd_news}</span></td>
            <td><span class="${btClass}">${b.spread.btcusd}</span> <span class="news-badge">ข่าว ${b.spread.btcusd_news}</span></td>
          </tr>`;
  });

  html += `
        </tbody>
      </table>
      <div class="spread-note">Standard Account เท่านั้น · ข้อมูล ณ พ.ค. 2026 · อัปเดตทุก 6 เดือน · ค่า spread ช่วงข่าวเป็น estimate อาจแตกต่างตามสภาวะตลาด</div>
    </div>
  </div>
  <div style="text-align:center;margin-top:24px">
    <button class="btn-restart" onclick="restart()">← เริ่มใหม่อีกครั้ง</button>
  </div>`;

  const el = document.getElementById('results');
  if (!el) return;
  el.innerHTML = html;
  el.classList.add('show');
  window.scrollTo({top:0,behavior:'smooth'});
}

function restart() {
  answers.q1=answers.q2=answers.q3=null;
  document.querySelectorAll('.opt').forEach(o=>o.classList.remove('selected'));
  document.querySelectorAll('.btn-next').forEach(b=>b.classList.remove('ready'));
  document.getElementById('results')?.classList.remove('show');
  const el = document.getElementById('results');
  if (el) el.innerHTML='';
  const stepsBar = document.getElementById('stepsBar');
  if (stepsBar) stepsBar.style.display='flex';
  goTo(1);
}

// @ts-expect-error - exposed for inline onclick handlers
window.select = select;
// @ts-expect-error - exposed for inline onclick handlers
window.goTo = goTo;
// @ts-expect-error - exposed for inline onclick handlers
window.showResults = showResults;
// @ts-expect-error - exposed for inline onclick handlers
window.restart = restart;
</script>
</body>
</html>
