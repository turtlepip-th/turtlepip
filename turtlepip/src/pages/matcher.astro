---
import Nav from '../components/Nav.astro';
---

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/shared.css">
<title>TurtlePip — รีวิวโบรกเกอร์ Forex จากข้อมูลจริง</title>
<style>
/* fonts from shared.css */
/* root + body from shared.css */
/* nav styles from shared.css */
.wrap{max-width:800px;margin:0 auto;padding:32px 24px}

/* HERO */
.hero{text-align:center;margin-bottom:36px}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:var(--gp);color:var(--gd);font-size:11px;font-weight:700;padding:4px 12px;border-radius:20px;margin-bottom:14px}
.hero h1{font-size:26px;font-weight:800;letter-spacing:-.5px;margin-bottom:8px;line-height:1.3}
.hero p{font-size:14px;color:var(--t2);max-width:480px;margin:0 auto}

/* STEPS */
.steps{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:32px}
.step-item{display:flex;align-items:center;gap:6px}
.step-num{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid var(--bdr);color:var(--t3);background:var(--surf);transition:all .2s}
.step-num.done{background:var(--gd);border-color:var(--gd);color:white}
.step-num.active{background:var(--surf);border-color:var(--gd);color:var(--gd)}
.step-label{font-size:11px;color:var(--t3);font-weight:500}
.step-label.active{color:var(--gd);font-weight:700}
.step-line{width:40px;height:2px;background:var(--bdr);margin:0 8px}
.step-line.done{background:var(--gd)}

/* QUESTION CARD */
.qcard{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--rl);padding:28px;margin-bottom:24px;display:none}
.qcard.show{display:block;animation:fadein .25s ease}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.qlabel{font-size:11px;font-weight:700;color:var(--t3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
.qtitle{font-size:18px;font-weight:800;letter-spacing:-.3px;margin-bottom:20px}
.options{display:flex;flex-direction:column;gap:8px}
.opt{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1.5px solid var(--bdr);border-radius:var(--r);cursor:pointer;transition:all .15s;background:var(--surf)}
.opt:hover{border-color:var(--gd);background:var(--gp)}
.opt.selected{border-color:var(--gd);background:var(--gp)}
.opt-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;background:var(--bg)}
.opt-title{font-size:13px;font-weight:700;color:var(--t1);margin-bottom:2px}
.opt-sub{font-size:11px;color:var(--t2);line-height:1.5}
.opt-check{width:18px;height:18px;border-radius:50%;border:2px solid var(--bdr);margin-left:auto;flex-shrink:0;margin-top:9px;transition:all .15s}
.opt.selected .opt-check{background:var(--gd);border-color:var(--gd);display:flex;align-items:center;justify-content:center}
.opt.selected .opt-check::after{content:'✓';color:white;font-size:10px;font-weight:800}
.qnav{display:flex;justify-content:space-between;align-items:center;margin-top:20px}
.btn-back{background:transparent;border:1px solid var(--bdrs);border-radius:8px;padding:10px 20px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--f);color:var(--t2)}
.btn-next{background:var(--gd);color:white;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:700;cursor:pointer;font-family:var(--f);opacity:.4;pointer-events:none;transition:all .15s}
.btn-next.ready{opacity:1;pointer-events:auto}

/* RESULTS */
.results{display:none}
.results.show{display:block;animation:fadein .3s ease}
.result-header{text-align:center;margin-bottom:28px}
.result-header h2{font-size:22px;font-weight:800;margin-bottom:6px}
.result-header p{font-size:13px;color:var(--t2)}
.result-summary{background:var(--gp);border:1px solid #C3E6A0;border-radius:var(--r);padding:12px 16px;margin-bottom:24px;display:flex;flex-wrap:wrap;gap:8px}
.summary-pill{background:var(--gd);color:white;font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px}

/* RESULT CARDS */
.rcard{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--rl);margin-bottom:16px;overflow:hidden;transition:all .15s}
.rcard:hover{border-color:var(--gd)}
.rcard.rank1{border:2px solid var(--gd)}
.rcard-top{padding:16px 20px;display:flex;align-items:flex-start;gap:14px}
.rank-badge{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex-shrink:0;font-family:monospace}
.rank-badge.r1{background:var(--gd);color:white}
.rank-badge.r2{background:var(--gp);color:var(--gd)}
.rank-badge.r3{background:var(--bg);color:var(--t2);border:1px solid var(--bdr)}
.broker-logo-wrap{width:44px;height:44px;border-radius:10px;overflow:hidden;border:1px solid var(--bdr);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.broker-logo-wrap img{width:100%;height:100%;object-fit:contain}
.rcard-info{flex:1;min-width:0}
.rcard-top-row{display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap}
.rcard-name{font-size:15px;font-weight:800;color:var(--t1)}
.badge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}
.bsafe{background:var(--safebg);color:var(--safe)}
.bwarn{background:var(--warnbg);color:var(--warn)}
.match-pct{background:#E6F1FB;color:#0C447C;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}
.rcard-why{font-size:12px;color:var(--t2);line-height:1.5;margin-bottom:10px}
.account-rec{background:var(--bg);border-radius:8px;padding:10px 12px;margin-bottom:0}
.account-rec-label{font-size:10px;font-weight:700;color:var(--t3);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.account-tags{display:flex;flex-wrap:wrap;gap:6px}
.acc-tag{background:var(--surf);border:1px solid var(--bdr);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;color:var(--t1)}
.acc-tag.recommended{background:var(--gp);border-color:#C3E6A0;color:var(--gd)}
.rcard-bottom{border-top:1px solid var(--bdr);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.score-row{display:flex;gap:16px;flex-wrap:wrap}
.score-item{text-align:center}
.score-label{font-size:10px;color:var(--t3);margin-bottom:2px}
.score-val{font-size:14px;font-weight:800;font-family:monospace}
.score-val.g{color:var(--safe)}.score-val.a{color:var(--warn)}
.btn-review{background:var(--gd);color:white;border:none;border-radius:8px;padding:9px 20px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--f);white-space:nowrap}
.rank1-tag{display:flex;align-items:center;gap:5px;background:var(--gd);color:white;font-size:11px;font-weight:700;padding:5px 12px;border-radius:0 0 var(--r) var(--r);margin-left:20px;width:fit-content;margin-bottom:-1px}

/* SPREAD TABLE */
.spread-section{margin-top:32px}
.spread-title{font-size:13px;font-weight:700;margin-bottom:12px}
.spread-card{background:var(--surf);border:1px solid var(--bdr);border-radius:var(--rl);overflow:hidden}
.spread-table{width:100%;border-collapse:collapse;font-size:12px}
.spread-table th{padding:9px 14px;text-align:center;font-size:10px;font-weight:700;color:var(--t3);letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid var(--bdr);background:var(--bg)}
.spread-table th:first-child{text-align:left}
.spread-table td{padding:10px 14px;text-align:center;font-family:monospace;font-weight:700;border-bottom:1px solid var(--bdr)}
.spread-table td:first-child{text-align:left;font-family:var(--f);font-weight:600;font-size:13px}
.spread-table tr:last-child td{border-bottom:none}
.spread-table tr.highlight{background:var(--gp)}
.sp-low{color:var(--safe)}.sp-mid{color:var(--warn)}.sp-high{color:var(--avoid)}
.spread-note{font-size:10px;color:var(--t3);padding:8px 14px;border-top:1px solid var(--bdr);background:var(--bg)}
.news-badge{background:#FFFBEB;color:var(--warn);font-size:9px;font-weight:700;padding:1px 5px;border-radius:4px;border:1px solid #FDE68A;vertical-align:middle;margin-left:4px}

.btn-restart{background:var(--bg);border:1px solid var(--bdrs);border-radius:8px;padding:10px 20px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--f);color:var(--t2);margin-top:8px}

footer{background:var(--surf);border-top:1px solid var(--bdr);margin-top:48px;padding:16px 28px;text-align:center;font-size:11px;color:var(--t3)}
</style>
</head>
<body>

<Nav active="matcher" />
<div class="wrap">

  <div class="hero">
    <div class="hero-tag">ระบบจับคู่โบรกเกอร์ — ทีมซุปเต่า</div>
    <h1>หาโบรกที่ใช่<br>สำหรับคุณโดยเฉพาะ</h1>
    <p>ตอบ 3 คำถาม ระบบจะแนะนำโบรกเกอร์และประเภทบัญชีที่เหมาะสมที่สุด พร้อมเหตุผลชัดเจน</p>
  </div>

  <!-- PROGRESS -->
  <div class="steps" id="stepsBar">
    <div class="step-item">
      <div class="step-num active" id="s1">1</div>
      <div class="step-label active" id="sl1">สไตล์เทรด</div>
    </div>
    <div class="step-line" id="line1"></div>
    <div class="step-item">
      <div class="step-num" id="s2">2</div>
      <div class="step-label" id="sl2">เงินทุน</div>
    </div>
    <div class="step-line" id="line2"></div>
    <div class="step-item">
      <div class="step-num" id="s3">3</div>
      <div class="step-label" id="sl3">Platform</div>
    </div>
  </div>

  <!-- Q1: STYLE -->
  <div class="qcard show" id="q1">
    <div class="qlabel">คำถามที่ 1 / 3</div>
    <div class="qtitle">คุณเทรดสไตล์ไหน?</div>
    <div class="options">
      <div class="opt" data-val="scalper" onclick="select(this,1)">
        <div class="opt-icon">⚡</div>
        <div><div class="opt-title">Scalper</div><div class="opt-sub">เปิดปิดเร็ว หลายออเดอร์ต่อวัน · ต้องการ spread ต่ำสุด · execution เร็ว</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="daytrader" onclick="select(this,1)">
        <div class="opt-icon">📊</div>
        <div><div class="opt-title">Day Trader</div><div class="opt-sub">เทรดในวัน ปิดก่อนตลาดหยุด · ดู chart เยอะ · ต้องการ platform ดี</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="swing" onclick="select(this,1)">
        <div class="opt-icon">🌊</div>
        <div><div class="opt-title">Swing Trader</div><div class="opt-sub">ถือ 2-7 วัน · ดู big picture · swap/overnight fee สำคัญ</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="copy" onclick="select(this,1)">
        <div class="opt-icon">📋</div>
        <div><div class="opt-title">Copy Trader</div><div class="opt-sub">ตามสัญญาณคนอื่น · ต้องการระบบ copy trade ที่ดี</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="news" onclick="select(this,1)">
        <div class="opt-icon">📰</div>
        <div><div class="opt-title">News Trader</div><div class="opt-sub">เทรดช่วงข่าว · ต้องการ slippage ต่ำ · execution ไวมาก</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="beginner" onclick="select(this,1)">
        <div class="opt-icon">🐢</div>
        <div><div class="opt-title">มือใหม่</div><div class="opt-sub">ยังไม่แน่ใจ · อยากเริ่มแบบปลอดภัย · ต้องการ support ภาษาไทย</div></div>
        <div class="opt-check"></div>
      </div>
    </div>
    <div class="qnav">
      <div></div>
      <button class="btn-next" id="next1" onclick="goTo(2)">ถัดไป →</button>
    </div>
  </div>

  <!-- Q2: CAPITAL -->
  <div class="qcard" id="q2">
    <div class="qlabel">คำถามที่ 2 / 3</div>
    <div class="qtitle">เงินทุนที่จะเริ่มต้น?</div>
    <div class="options">
      <div class="opt" data-val="micro" onclick="select(this,2)">
        <div class="opt-icon">💵</div>
        <div><div class="opt-title">น้อยกว่า $100</div><div class="opt-sub">เริ่มต้นเล็กน้อย · ต้องการ micro account · ฝากขั้นต่ำน้อย</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="small" onclick="select(this,2)">
        <div class="opt-icon">💴</div>
        <div><div class="opt-title">$100 — $500</div><div class="opt-sub">Standard micro account · เหมาะกับมือใหม่ถึงระดับกลาง</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="medium" onclick="select(this,2)">
        <div class="opt-icon">💶</div>
        <div><div class="opt-title">$500 — $2,000</div><div class="opt-sub">Standard account เต็มรูปแบบ · เข้าถึงเงื่อนไขที่ดีกว่า</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="large" onclick="select(this,2)">
        <div class="opt-icon">💷</div>
        <div><div class="opt-title">มากกว่า $2,000</div><div class="opt-sub">Pro/ECN account · spread ต่ำสุด · เงื่อนไขดีที่สุด</div></div>
        <div class="opt-check"></div>
      </div>
    </div>
    <div class="qnav">
      <button class="btn-back" onclick="goTo(1)">← ย้อนกลับ</button>
      <button class="btn-next" id="next2" onclick="goTo(3)">ถัดไป →</button>
    </div>
  </div>

  <!-- Q3: PLATFORM -->
  <div class="qcard" id="q3">
    <div class="qlabel">คำถามที่ 3 / 3</div>
    <div class="qtitle">Platform ที่ใช้หรืออยากใช้?</div>
    <div class="options">
      <div class="opt" data-val="mt" onclick="select(this,3)">
        <div class="opt-icon">🖥️</div>
        <div><div class="opt-title">MT4 / MT5</div><div class="opt-sub">Classic · รองรับ EA / bot · indicator เยอะ · ใช้งานง่าย</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="tv" onclick="select(this,3)">
        <div class="opt-icon">📈</div>
        <div><div class="opt-title">TradingView</div><div class="opt-sub">Chart สวย · indicator ทันสมัย · community ใหญ่ · ต้องการโบรกที่ integrate ได้</div></div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" data-val="any" onclick="select(this,3)">
        <div class="opt-icon">🤷</div>
        <div><div class="opt-title">ยังไม่มี — แนะนำให้เลย</div><div class="opt-sub">ให้ทีมซุปเต่าแนะนำ platform ที่เหมาะกับสไตล์การเทรดของคุณ</div></div>
        <div class="opt-check"></div>
      </div>
    </div>
    <div class="qnav">
      <button class="btn-back" onclick="goTo(2)">← ย้อนกลับ</button>
      <button class="btn-next" id="next3" onclick="showResults()">ดูผลลัพธ์ →</button>
    </div>
  </div>

  <!-- RESULTS -->
  <div class="results" id="results"></div>

</div>

<footer>© 2026 TurtlePip.com · ไม่รับโฆษณาจากโบรกเกอร์ · การเทรด Forex มีความเสี่ยงสูง</footer>

